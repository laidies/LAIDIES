{
  "version": "2026-08-12.2",
  "mode": "review-routing-only",
  "publicationAuthority": "none",
  "maximumCandidateAgeDays": 31,
  "enabledEditions": ["daily", "weekly"],
  "minimumScores": {
    "evidence": 3,
    "total": 13,
    "consequence": 2,
    "novelty": 1,
    "readerRelevance": 2,
    "durability": 1,
    "editorialValue": 2
  },
  "minimumSources": 2,
  "minimumPrimarySources": 1,
  "requiredChecks": [
    "claimMapComplete",
    "showsDoesNotShow",
    "impactSeparatedFromInference",
    "readerExplanationComplete",
    "freshnessSweep",
    "captureSweep",
    "localLinksResolve",
    "unsafeHtmlFree",
    "placeholdersFree",
    "copyrightOriginal",
    "disputedClaimsLabeled",
    "publicationDayRecheckComplete",
    "renderPassed"
  ],
  "conditionalGates": {
    "releaseDetailsComplete": {
      "topics": ["model-release", "feature-release"]
    },
    "sensationalFramingNeutralized": {
      "riskSignals": ["sensational_or_misleading_claim"]
    }
  },
  "allowedRiskDomains": [
    "none",
    "health",
    "medical",
    "legal",
    "financial",
    "cybersecurity",
    "privacy",
    "safety",
    "children",
    "elections",
    "war",
    "crime",
    "employment-allegations",
    "regulatory-enforcement"
  ],
  "hardHoldRiskDomains": [
    "health",
    "medical",
    "legal",
    "financial",
    "cybersecurity",
    "privacy",
    "safety",
    "children",
    "elections",
    "war",
    "crime",
    "employment-allegations",
    "regulatory-enforcement"
  ],
  "hardHoldSignals": [
    "disputed_facts",
    "unconfirmed_model_identity",
    "ongoing_incident",
    "possible_personal_data_impact",
    "single_interested_source",
    "named_person_allegation",
    "material_prediction",
    "novel_tribune_thread"
  ],
  "automaticRejectSignals": [
    "fabricated_source",
    "unresolvable_source",
    "unsafe_html",
    "placeholder",
    "copyright_copying",
    "missing_claim_map"
  ],
  "allowedRiskSignals": [
    "sensational_or_misleading_claim",
    "disputed_facts",
    "unconfirmed_model_identity",
    "ongoing_incident",
    "possible_personal_data_impact",
    "single_interested_source",
    "named_person_allegation",
    "material_prediction",
    "novel_tribune_thread",
    "fabricated_source",
    "unresolvable_source",
    "unsafe_html",
    "placeholder",
    "copyright_copying",
    "missing_claim_map"
  ],
  "tribunePolicy": "hold_until_level_3"
}
