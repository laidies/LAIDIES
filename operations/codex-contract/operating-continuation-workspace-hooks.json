{
  "description": "Route each existing admitted LAiDIES session to its governing task. Unbound or terminal sessions are untouched. This bounded guard is not a scheduler; native trust/loading remains separately verified.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"/Users/alisoneakin/Projects/laidies-operating-integration-20260905/.codex/hooks/route_operating_session.py\"",
            "timeout": 40,
            "statusMessage": "Checking the bound operating task"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"/Users/alisoneakin/Projects/laidies-operating-integration-20260905/.codex/hooks/route_operating_session.py\"",
            "timeout": 40,
            "statusMessage": "Checking the bound operating task"
          }
        ]
      }
    ]
  }
}
