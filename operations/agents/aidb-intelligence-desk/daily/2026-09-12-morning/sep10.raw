      "accent": "cyan"
    },
    {
      "value": "19 of 22",
      "label": "Congressional responders who were Democrats",
      "accent": "cyan"
    },
    {
      "value": "$500M",
      "label": "SBF's 2022 lead of Anthropic's Series B — a stake now worth $30B+",
      "accent": "green"
    },
    {
      "value": "<24h",
      "label": "From X post to national coverage, per Jason Calacanis",
      "accent": "red"
    },
