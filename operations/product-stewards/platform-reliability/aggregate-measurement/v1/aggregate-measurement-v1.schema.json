{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://laidies.com/schemas/aggregate-measurement-v1.schema.json",
  "title": "LAiDIES privacy-safe aggregate measurement snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "snapshotId",
    "generatedAt",
    "validUntil",
    "period",
    "provenance",
    "privacy",
    "sources",
    "metrics",
    "pageRankings",
    "social",
    "integrity"
  ],
  "properties": {
    "schemaVersion": {"const": "laidies.aggregate-measurement.v1"},
    "snapshotId": {"type": "string", "pattern": "^AUD-MEAS-[0-9]{4}-[0-9]{2}-[0-9]{2}-[A-Z0-9-]+$"},
    "generatedAt": {"type": "string", "format": "date-time"},
    "validUntil": {"type": "string", "format": "date-time"},
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end", "timezone"],
      "properties": {
        "start": {"type": "string", "format": "date"},
        "end": {"type": "string", "format": "date"},
        "timezone": {"const": "America/Vancouver"}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourcePath", "sourceSha256", "observedAt"],
      "properties": {
        "sourcePath": {"const": "operations/product-stewards/audience-growth/measurement-state.json"},
        "sourceSha256": {"$ref": "#/$defs/sha256"},
        "observedAt": {"type": "string", "format": "date-time"}
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "minimumPublishedCohort", "rawDataRetained", "prohibitedFields"],
      "properties": {
        "mode": {"const": "aggregate-only"},
        "minimumPublishedCohort": {"type": "integer", "minimum": 5},
        "rawDataRetained": {"const": false},
        "prohibitedFields": {
          "type": "array",
          "minItems": 10,
          "uniqueItems": true,
          "items": {"type": "string"}
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/source"}
    },
    "metrics": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {"$ref": "#/$defs/metric"}
    },
    "pageRankings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "definition", "items", "owner", "nextAction"],
      "properties": {
        "status": {"enum": ["ready", "unknown", "not-connected", "stale", "provider-error"]},
        "definition": {"type": "string", "minLength": 20},
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["routeId", "visitors"],
            "properties": {
              "routeId": {"type": "string", "pattern": "^[a-z0-9-]+$"},
              "visitors": {"type": "integer", "minimum": 5}
            }
          }
        },
        "owner": {"type": "string", "minLength": 3},
        "nextAction": {"type": "string", "minLength": 10}
      }
    },
    "social": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "planned",
        "builtLocally",
        "readyToPublish",
        "published",
        "evidenceRef",
        "owner",
        "nextAction"
      ],
      "properties": {
        "status": {"enum": ["repository-counts-only", "provider-verified"]},
        "planned": {"type": "integer", "minimum": 0},
        "builtLocally": {"type": "integer", "minimum": 0},
        "readyToPublish": {"type": "integer", "minimum": 0},
        "published": {"type": "integer", "minimum": 0},
        "evidenceRef": {"type": "string", "minLength": 5},
        "owner": {"type": "string", "minLength": 3},
        "nextAction": {"type": "string", "minLength": 10}
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "canonicalization", "payloadSha256"],
      "properties": {
        "algorithm": {"const": "SHA-256"},
        "canonicalization": {"const": "RFC8785-JCS"},
        "payloadSha256": {"$ref": "#/$defs/sha256"}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "observedAt", "freshUntil", "evidenceRef", "owner", "nextAction"],
      "properties": {
        "id": {"enum": ["plausible", "resident-card", "social"]},
        "status": {"enum": ["ready", "not-connected", "not-verified", "manual-partial", "stale", "provider-error"]},
        "observedAt": {"type": "string", "format": "date-time"},
        "freshUntil": {"type": "string", "format": "date-time"},
        "evidenceRef": {"type": "string", "minLength": 5},
        "owner": {"type": "string", "minLength": 3},
        "nextAction": {"type": "string", "minLength": 10}
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "definitionVersion", "definition", "value", "unit", "status", "sourceId", "owner", "nextAction"],
      "properties": {
        "id": {"enum": ["visitors", "new-visitors", "resident-card-signups", "returning-rate"]},
        "definitionVersion": {"const": "v1"},
        "definition": {"type": "string", "minLength": 20},
        "value": {"type": ["number", "null"], "minimum": 0},
        "unit": {"enum": ["people", "percent"]},
        "status": {"enum": ["ready", "unknown", "not-connected", "not-verified", "stale", "provider-error", "suppressed"]},
        "sourceId": {"enum": ["plausible", "resident-card"]},
        "owner": {"type": "string", "minLength": 3},
        "nextAction": {"type": "string", "minLength": 10}
      }
    }
  }
}
