" (https://aidailybrief.ai/agent.json)\nciteturn886view0 [wordlim: 200] Crawled: today; Content type: application/json; Source: open({\"ref_id\":\"https://aidailybrief.ai/agent.json\",\"lineno\":null}); Total lines: 1548\nL0: {\nL1:   \"site\": \"https://aidailybrief.ai\",\nL2:   \"show\": {\nL3:     \"title\": \"The AI Daily Brief\",\nL4:     \"host\": \"Nathaniel Whittemore\",\nL5:     \"listen\": {\nL6:       \"all\": \"https://pod.link/1680633614\",\nL7:       \"spotify\": \"https://open.spotify.com/show/7gKwwMLFLc6RmjmRpbMtEO\",\nL8:       \"apple\": \"https://podcasts.apple.com/us/podcast/the-ai-daily-brief-artificial-intelligence-news/id1680633614\",\nL9:       \"youtube\": \"https://www.youtube.com/@AIDailyBrief\",\nL10:       \"adFree\": \"https://patreon.com/aidailybrief\"\nL11:     }\nL12:   },\nL13:   \"generated\": \"2026-09-19T16:59:11.150Z\",\nL14:   \"endpoints\": {\nL15:     \"llms\": \"https://aidailybrief.ai/llms.txt\",\nL16:     \"llmsFull\": \"https://aidailybrief.ai/llms-full.txt\",\nL17:     \"mcp\": null\nL18:   },\nL19:   \"editions\": [\nL20:     {\nL21:       \"date\": \"2026-09-17\",\nL22:       \"weekday\": \"Thu\",\nL23:       \"type\": \"daily\",\nL24:       \"title\": \"Why Everyone Is Getting Excited About Personal AI Agents\",\nL25:       \"teaser\": \"A month after 'normal people don't use AI agents' was conventional wisdom, Meta's Muse is #2 on the App Store and even NLW is checking his priors. Plus: the Fed's first hike in three years targets the AI buildout, and OpenAI formalizes misalignment disclosure.\",\nL26:       \"tags\": [\nL27:         \"business\",\nL28:         \"take\"\nL29:       ],\nL30:       \"durationMin\": 30,\nL31:       \"html\": \"https://aidailybrief.ai/e/2026-09-17\",\nL32:       \"markdown\": \"https://aidailybrief.ai/e/2026-09-17.md\",\nL33:       \"json\": \"https://aidailybrief.ai/e/2026-09-17.json\",\nL34:       \"transcript\": \"https://aidailybrief.ai/e/2026-09-17/transcript.md\"\nL35:     },\nL36:     {\nL37:       \"date\": \"2026-09-16\",\nL38:       \"weekday\": \"Wed\",\nL39:       \"type\": \"daily\",\nL40:       \"title\": \"Why a New Class of AI “Judgment Models” Could Have Big Business Implications\",\nL41:       \"teaser\": \"TypeSafe's Jev answers questions with calibrated probabilities instead of prose — claiming 20–200× faster and 40–400× cheaper than LLMs — and could become the cheap decision layer inside business software. Plus Zuckerberg's answer to the slowdown debate and the Sanders-Bannon alliance.\",\nL42:       \"tags\": [\nL43:         \"models\",\nL44:         \"enterprise\",\nL45:         \"policy\"\nL46:       ],\nL47:       \"durationMin\": 25,\nL48:       \"html\": \"https://aidailybrief.ai/e/2026-09-16\",\nL49:       \"markdown\": \"https://aidailybrief.ai/e/2026-09-16.md\",\nL50:       \"json\": \"https://aidailybrief.ai/e/2026-09-16.json\",\nL51:       \"transcript\": \"https://aidailybrief.ai/e/2026-09-16/transcript.md\"\nL52:     },\nL53:     {\nL54:       \"date\": \"2026-09-15\",\nL55:       \"weekday\": \"Tue\",\nL56:       \"type\": \"daily\",\nL57:       \"title\": \"Trump Rails Against AI Slowdown \\\"Hoax\\\"\",\nL58:       \"teaser\": \"Trump declares the AI slowdown a 'hoax' across seven Truth Social posts while Obama publicly backs it — AI safety is now officially partisan. Plus: Terence Tao's open letter against the labs, and a grim Census study on new graduates.\",\nL59:       \"tags\": [\nL60:         \"policy\",\nL61:         \"models\"\nL62:       ],\nL63:       \"durationMin\": 26,\nL64:       \"html\": \"https://aidailybrief.ai/e/2026-09-15\",\nL65:       \"markdown\": \"https://aidailybrief.ai/e/2026-09-15.md\",\nL66:       \"json\": \"https://aidailybrief.ai/e/2026-09-15.json\",\nL67:       \"transcript\": \"https://aidailybrief.ai/e/2026-09-15/transcript.md\"\nL68:     },\nL69:     {\nL70:       \"date\": \"2026-09-14\",\nL71:       \"weekday\": \"Mon\",\nL72:       \"type\": \"daily\",\nL73:       \"title\": \"Even Other AI Labs Are Rallying Around Anthropic’s Slowdown Proposal\",\nL74:       \"teaser\": \"Dario Amodei's 'We Must Pace the Frontier' pulled Altman, Musk, Hassabis, and Nadella publicly on board with slowing AI down. Between the IPO cynics, the antitrust lawyers, and Beijing's 'Cold War' accusations, the negotiation over AI's next phase just started in earnest.\",\nL75:       \"tags\": [\nL76:         \"policy\",\nL77:         \"models\",\nL78:         \"take\"\nL79:       ],\nL80:       \"durationMin\": 37,\nL81:       \"html\": \"https://aidailybrief.ai/e/2026-09-14\",\nL82:       \"markdown\": \"https://aidailybrief.ai/e/2026-09-14.md\",\nL83:       \"json\": \"https://aidailybrief.ai/e/2026-09-14.json\",\nL84:       \"transcript\": \"https://aidailybrief.ai/e/2026-09-14/transcript.md\"\nL85:     },\nL86:     {\nL87:       \"date\": \"2026-09-13\",\nL88:       \"weekday\": \"Sun\",\nL89:       \"type\": \"daily\",\nL90:       \"title\": \"10 Ways to Think Bigger with Opportunity AI\",\nL91:       \"teaser\": \"GPT-6 Astra confounds — coders are retreating while new capabilities like games, video pipelines, and 3D go unexplored. A weekend big-think with a dozen thought starters for opportunity AI, plus an interactive companion on the site.\",\nL92:       \"tags\": [\nL93:         \"models\",\nL94:         \"take\"\nL95:       ],\nL96:       \"durationMin\": 28,\nL97:       \"html\": \"https://aidailybrief.ai/e/2026-09-13\",\nL98:       \"markdown\": \"https://aidailybrief.ai/e/2026-09-13.md\",\nL99:       \"json\": \"https://aidailybrief.ai/e/2026-09-13.json\",\nL100:       \"transcript\": \"https://aidailybrief.ai/e/2026-09-13/transcript.md\"\nL101:     },\nL102:     {\nL103:       \"date\": \"2026-09-11\",\nL104:       \"weekday\": \"Fri\",\nL105:       \"type\": \"daily\",\nL106:       \"title\": \"What to Use the Latest AI Tools For\",\nL107:       \"teaser\": \"OpenAI hits a compute wall and pauses $200 Pro plans while a second wave of releases points at two big trends: voice-first interfaces and cheap, good-enough models. NLW rips through eight-plus launches — who each is for and what to actually do with it.\",\nL108:       \"tags\": [\nL109:         \"models\",\nL110:         \"enterprise\",\nL111:         \"compute\"\nL112:       ],\nL113:       \"durationMin\": 32,\nL114:       \"html\": \"https://aidailybrief.ai/e/2026-09-11\",\nL115:       \"markdown\": \"https://aidailybrief.ai/e/2026-09-11.md\",\nL116:       \"json\": \"https://aidailybrief.ai/e/2026-09-11.json\",\nL117:       \"transcript\": \"https://aidailybrief.ai/e/2026-09-11/transcript.md\"\nL118:     },\nL119:     {\nL120:       \"date\": \"2026-09-10\",\nL121:       \"weekday\": \"Thu\",\nL122:       \"type\": \"daily\",\nL123:       \"title\": \"Anthropic Researcher Says AI Has Over a 10% Chance of Killing All Humans\",\nL124:       \"teaser\": \"An Anthropic researcher's resignation and a colleague's >10% doom odds went 200-million-views viral. NLW skips the outrage and unpacks why the decade-old x-risk message suddenly landed — and where the conversation should go next.\",\nL125:       \"tags\": [\nL126:         \"models\",\nL127:         \"policy\",\nL128:         \"take\"\nL129:       ],\nL130:       \"durationMin\": 36,\nL131:       \"html\": \"https://aidailybrief.ai/e/2026-09-10\",\nL132:       \"markdown\": \"https://aidailybrief.ai/e/2026-09-10.md\",\nL133:       \"json\": \"https://aidailybrief.ai/e/2026-09-10.json\",\nL134:       \"transcript\": \"https://aidailybrief.ai/e/2026-09-10/transcript.md\"\nL135:     },\nL136:     {\nL137:       \"date\": \"2026-09-09\",\nL138:       \"weekday\": \"Wed\",\nL139:       \"type\": \"daily\",\nL140:       \"title\": \"AI Model Month Is Off to a Blistering Start\",\nL141:       \"teaser\": \"Three new models, a personal agent, and a Millennium Prize solve wrapped in a scooping scandal. Model month is delivering capability, cost curves, and drama in equal measure.\",\nL142:       \"tags\": [\nL143:         \"models\",\nL144:         \"business\"\nL145:       ],\nL146:       \"durationMin\": 34,\nL147:       \"html\": \"https://aidailybrief.ai/e/2026-09-09\",\nL148:       \"markdown\": \"https://aidailybrief.ai/e/2026-09-09.md\",\nL149:       \"json\": \"https://aidailybrief.ai/e/2026-09-09.json\",\nL150:       \"transcript\": \"https://aidailybrief.ai/e/2026-09-09/transcript.md\"\nL151:     },\nL152:     {\nL153:       \"date\": \"2026-09-08\",\nL154:       \"weekday\": \"Tue\",\nL155:       \"type\": \"daily\",\nL156:       \"title\": \"Why GPT-6 Astra Is So Significant and So Confounding\",\nL157:       \"teaser\": \"GPT-6 Astra is the most significant and confounding release in a long time: benchmarks initially tied its predecessor while one-shot 3D games and hours-long computer use blew minds. The key is that it's an opportunity model, not an efficiency one — it expands what you can do rather than improving what you already do.\",\nL158:       \"tags\": [\nL159:         \"models\",\nL160:         \"take\"\nL161:       ],\nL162:       \"durationMin\": 29,\nL163:       \"html\": \"https://aidailybrief.ai/e/2026-09-08\",\nL164:       \"markdown\": \"https://aidailybrief.ai/e/2026-09-08.md\",\nL165:       \"json\": \"https://aidailybrief.ai/e/2026-09-08.json\",\nL166:       \"transcript\": \"https://aidailybrief.ai/e/2026-09-08/transcript.md\"\nL167:     },\nL168:     {\nL169:       \"date\": \"2026-09-07\",\nL170:       \"weekday\": \"Mon\",\nL171:       \"type\": \"daily\",\nL172:       \"title\": \"The Multiplayer AI Sprint: Build Your Team’s First Shared Agent\",\nL173:       \"teaser\": \"A Labor Day special: why the next frontier of agents is the shared spaces teams inhabit — with evidence from Every, Claude Tag, OpenClaw, and YC — plus the launch of a free four-week sprint to ship your team's first shared agent.\",\nL174:       \"tags\": [\nL175:         \"enterprise\",\nL176:         \"take\"\nL177:       ],\nL178:       \"durationMin\": 26,\nL179:       \"html\": \"https://aidailybrief.ai/e/2026-09-07\",\nL180:       \"markdown\": \"https://aidailybrief.ai/e/2026-09-07.md\",\nL181:       \"json\": \"https://aidailybrief.ai/e/2026-09-07.json\",\nL182:       \"transcript\": \"https://aidailybrief.ai/e/2026-09-07/transcript.md\"\nL183:     },\nL184:     {\nL185:       \"date\": \"2026-09-06\",\nL186:       \"weekday\": \"Sun\",\nL187:       \"type\": \"daily\",\nL188:       \"title\": \"How to Build an AI-Native Company Today\",\nL189:       \"teaser\": \"A feature-by-feature tour of what actually makes a company AI-native — Alex Lieberman's 30-point list with NLW's agreements, quibbles, and enterprise field notes, plus the missing 31st feature: someone has to own the result.\",\nL190:       \"tags\": [\nL191:         \"enterprise\",\nL192:         \"take\"\nL193:       ],\nL194:       \"durationMin\": 28,\nL195:       \"html\": \"https://aidailybrief.ai/e/2026-09-06\",\nL196:       \"markdown\": \"https://aidailybrief.ai/e/2026-09-06.md\",\nL197:       \"json\": \"https://aidailybrief.ai/e/2026-09-06.json\",\nL198:       \"transcript\": \"https://aidailybrief.ai/e/2026-09-06/transcript.md\"\nL199:     },\nL200:     {\nL201:       \"date\": \"2026-09-04\",\nL202:       \"weekday\": \"Fri\",\nL203:       \"type\": \"daily\",\nL204:       \"title\": \"How AI Changed This Summer\",\nL205:       \"teaser\": \"A holiday-weekend retrospective: Washington became a release gate, Kimi K3 forced another DeepSeek moment, CFOs got their revenge on tokens, agent management became a field, and the Hugging Face incident fired the warning shot. Somehow, it all still feels like prelude.\",\nL206:       \"tags\": [\nL207:         \"models\",\nL208:         \"policy\",\nL209:         \"enterprise\"\nL210:       ],\nL211:       \"durationMin\": 24,\nL212:       \"html\": \"https://aidailybrief.ai/e/2026-09-04\",\nL213:       \"markdown\": \"https://aidailybrief.ai/e/2026-09-04.md\",\nL214:       \"json\": \"https://aidailybrief.ai/e/2026-09-04.json\",\nL215:       \"transcript\": \"https://aidailybrief.ai/e/2026-09-04/transcript.md\"\nL216:     },\nL217:     {\nL218:       \"date\": \"2026-09-03\",\nL219:       \"weekday\": \"Thu\",\nL220:       \"type\": \"daily\",\nL221:       \"title\": \"Agentic Loops for Knowledge Workers\",\nL222:       \"teaser\": \"A hands-on webinar with Nufar Gaspar on loop and graph engineering for knowledge workers: when to loop, how to design a verifiable finish line, and when to compose agents into teams — with a live Claude Code demo.\",\nL223:       \"tags\": [\nL224:         \"enterprise\"\nL225:       ],\nL226:       \"durationMin\": 57,\nL227:       \"html\": \"https://aidailybrief.ai/e/2026-09-03\",\nL228:       \"markdown\": \"https://aidailybrief.ai/e/2026-09-03.md\",\n--------------------------------------------------------------------------------\nInternal Error ()\nciteturn886view1 [wordlim: 200] Source: open({\"ref_id\":\"https://aidailybrief.ai/e/2026-09-19.json\",\"lineno\":null}); Total lines: 1\n--------------------------------------------------------------------------------\nInternal Error ()\nciteturn886view2 [wordlim: 200] Source: open({\"ref_id\":\"https://aidailybrief.ai/e/2026-09-19/transcript.md\",\"lineno\":null}); Total lines: 1\n--------------------------------------------------------------------------------\nNewsroom \\ Anthropic (https://www.anthropic.com/news)\nciteturn886view3 [wordlim: 200] Crawled: today; Content type: text/html; Source: open({\"ref_id\":\"https://www.anthropic.com/news\",\"lineno\":null}); Total lines: 37\n--------------------------------------------------------------------------------\nOpenAI News | OpenAI (https://openai.com/news/)\nciteturn886view4 [wordlim: 200] Crawled: today; Content type: text/html; Source: open({\"ref_id\":\"https://openai.com/news/\",\"lineno\":null}); Total lines: 139\n"
