106.591 108.516 106.567 109.335 106.567C112.03 106.567 114.552 106.829 116.844 107.33C115.989 118.008 110.974 119.742 106.555 119.985Z' fill='#BAC2CE'\u003e\u003c/path\u003e\u003c/svg\u003e\u003c/div\u003e\u003c/a\u003e\u003ca href='https://www.linkedin.com/sharing/share-offsite?url=https%3A%2F%2Faidailybrief.beehiiv.com%2Fp%2Feven-other-ai-labs-are-rallying-around-anthropic-s-slowdown-proposal' target='_blank'\u003e\u003cdiv style='max-width:28px;'\u003e\u003csvg fill='none' height='100%' viewBox='0 0 211 211' width='100%' xmlns='http://www.w3.org/2000/svg'\u003e\u003ccircle cx='105.5' cy='105.5' fill-opacity='0.15' fill='#9CA3AF' r='105.5'\u003e\u003c/circle\u003e\u003cpath d='M82.1892 75.4698C82.1892 80.1362 78.526 83.8026 73.8638 83.8026C69.2015 83.8026 65.5383 80.1362 65.5383 75.4698C65.5383 70.8034 69.2015 67.137 73.8638 67.137C78.526 67.137 82.1892 70.8034 82.1892 75.4698ZM82.1892 90.4689H65.5383V143.799H82.1892V90.4689ZM108.831 90.4689H92.1797V143.799H108.831V115.801C108.831 100.135 128.812 98.8017 128.812 115.801V143.799H145.463V110.134C145.463 83.8026 115.824 84.8026 108.831 97.8018V90.4689Z' fill='#BAC2CE'\u003e\u003c/path\u003e\u003c/svg\u003e\u003c/div\u003e\u003c/a\u003e\u003c/div\u003e\u003c/div\u003e\u003c/div\u003e\u003cdiv id='content-blocks'\u003e\u003cdiv style=\"padding-bottom:12px;padding-left:20px;padding-right:20px;padding-top:12px;text-align:center;width:100%;word-break:break-word;\"\u003e\u003ca target=\"_blank\" rel=\"noopener nofollow noreferrer\" href=\"https://open.spotify.com/episode/4AkBuqC02D2eDCCptzH2KK?si=bc96eb7285734067\u0026utm_source=aidailybrief.beehiiv.com\u0026utm_medium=referral\u0026utm_campaign=even-other-ai-labs-are-rallying-around-anthropic-s-slowdown-proposal\"\u003e\u003cbutton style=\"background-color:#FAFAF8;border-radius:8px;border:1px solid #c23c2a;color:#c23c2a;cursor:pointer;font-family:'Georgia','Times New Roman',serif;font-size:11px;font-weight:400;line-height:13px;padding:10px 17px;width:fit-content;\" type=\"button\"\u003e ▶ Listen to the episode \u003c/button\u003e\u003c/a\u003e\u003c/div\u003e\u003cdiv style=\"font-size:0px;line-height:0px;padding:30px 0px 30px;\"\u003e\u003cdiv style=\"margin: 0 auto; border-top: 3px solid #e0ddd8; width:50%;\"\u003e\u003c/div\u003e\u003c/div\u003e\u003cdiv id=\"main-story\" style=\"padding-bottom:4px;padding-left:20px;padding-right:20px;padding-top:16px;\"\u003e\u003ch3 style=\"color:#1a1a1a;font-family:'Georgia','Times New Roman',serif;font-size:15px;font-weight:400;line-height:1.25;margin:0;text-align:left;\"\u003eMAIN STORY\u003c/h3\u003e\u003c/div\u003e\u003cdiv id=\"ai-companies-begin-to-align-around-\" style=\"padding-bottom:4px;padding-left:20px;padding-right:20px;padding-top:16px;\"\u003e\u003ch2 style=\"color:#1a1a1a;font-family:'Georgia','Times New Roman',serif;font-size:21px;font-weight:400;line-height:1.5;margin:0;text-align:left;\"\u003eAI Companies Begin to Align Around a Slowdown\u003c/h2\u003e\u003c/div\u003e\u003cstyle\u003e\n  p span[style*=\"font-size\"] { line-height: 1.6; }\n\u003c/style\u003e\u003cdiv style=\"padding-bottom:12px;padding-left:20px;padding-right:20px;padding-top:12px;\"\u003e\u003cp style=\"color:#1a1a1a;color:var(--wt-text-on-background-color) !important;font-family:'Georgia','Times New Roman',serif;font-size:15px;line-height:1.7;text-align:left;\"\u003e The AI discourse took a major step forward this weekend, not only because Anthropic CEO Dario Amodei published a 3,000-word essay called \u0026quot;We Must Pace the Frontier,\u0026quot; but because the leaders of most of the other frontier labs came out publicly to support it. More than anything that has come before, the essay carries a set of specific proposals, which gives the debate something far more tangible than the usual vagaries of general AI risk. It\u0026#39;s early, but it feels like a major inflection point — the labs recognizing that the days of being the sole arbiters of how fast AI moves are coming to a close, and the negotiations over what the next phase means beginning. \u003c/p\u003e\u003c/div\u003e\u003cstyle\u003e\n  p span[style*=\"font-size\"] { line-height: 1.6; }\n\u003c/style\u003e\u003cdiv style=\"padding-bottom:12px;padding-left:20px;padding-right:20px;padding-top:12px;\"\u003e\u003cp style=\"color:#1a1a1a;color:var(--wt-text-on-background-color) !important;font-family:'Georgia','Times New Roman',serif;font-size:15px;line-height:1.7;text-align:left;\"\u003e NYT \u003ca class=\"link\" href=\"https://www.nytimes.com/2026/09/12/technology/anthropic-dario-amodei-ai-slowdown.html?utm_source=aidailybrief.beehiiv.com\u0026utm_medium=referral\u0026utm_campaign=even-other-ai-labs-are-rallying-around-anthropic-s-slowdown-proposal\" target=\"_blank\" rel=\"noopener noreferrer nofollow\" style=\"-webkit-text-decoration:underline #1a1a1a;color:#1a1a1a;font-style:italic;text-decoration:underline #1a1a1a;word-break:break-word;;\"\u003eTop A.I. Leaders Call for Slowing Down A.I. Development\u003c/a\u003e\u003cbr\u003eThe Verge \u003ca class=\"link\" href=\"https://www.theverge.com/ai-artificial-intelligence/994337/anthropic-ceo-slow-down-ai-development?utm_source=aidailybrief.beehiiv.com\u0026utm_medium=referral\u0026utm_campaign=even-other-ai-labs-are-rallying-around-anthropic-s-slowdown-proposal\" target=\"_blank\" rel=\"noopener noreferrer nofollow\" style=\"-webkit-text-decoration:underline #1a1a1a;color:#1a1a1a;font-style:italic;text-decoration:underline #1a1a1a;word-break:break-word;;\"\u003eAnthropic CEO says it\u0026#39;s time to pump the brakes on AI\u003c/a\u003e\u003cbr\u003eThe Information \u003ca class=\"link\" href=\"https://www.theinformation.com/briefings/amodei-calls-ai-companies-coordinate-safety?utm_source=aidailybrief.beehiiv.com\u0026utm_medium=referral\u0026utm_campaign=even-other-ai-labs-are-rallying-around-anthropic-s-slowdown-proposal\" target=\"_blank\" rel=\"noopener noreferrer nofollow\" style=\"-webkit-text-decoration:underline #1a1a1a;color:#1a1a1a;font-style:italic;text-decoration:underline #1a1a1a;word-break:break-word;;\"\u003eAltman and Musk Back Amodei\u0026#39;s Call for AI Companies to Slow Down AI Development\u003c/a\u003e\u003cbr\u003eThe Information \u003ca class=\"link\" href=\"https://www.theinformation.com/articles/inside-ai-industrys-behind-scenes-push-police?utm_source=aidailybrief.beehiiv.com\u0026utm_medium=referral\u0026utm_campaign=even-other-ai-labs-are-rallying-around-anthropic-s-slowdown-proposal\" target=\"_blank\" rel=\"noopener noreferrer nofollow\" style=\"-webkit-text-decoration:underline #1a1a1a;color:#1a1a1a;font-style:italic;text-decoration:underline #1a1a1a;word-break:break-word;;\"\u003eAnthropic, OpenAI, Google Quietly Discussed an AI Safety Standards Body\u003c/a\u003e\u003cbr\u003eThe Information \u003ca class=\"link\" href=\"https://www.theinformation.com/newsletters/the-briefing/ais-pacing-obsession-misses-real-political-problem?utm_source=aidailybrief.beehiiv.com\u0026utm_medium=referral\u0026utm_campaign=even-other-ai-labs-are-rallying-around-anthropic-s-slowdown-proposal\" target=\"_blank\" rel=\"noopener noreferrer nofollow\" style=\"-webkit-text-decoration:underline #1a1a1a;color:#1a1a1a;font-style:italic;text-decoration:underline #1a1a1a;word-break:break-word;;\"\u003eAI\u0026#39;s \u0026#39;Pacing\u0026#39; Obsession Misses Real Political Problem\u003c/a\u003e\u003c/p\u003e\u003c/div\u003e\u003cdiv id=\"labs-align-on-pacing-plan\" style=\"padding-bottom:4px;padding-left:20px;padding-right:20px;padding-top:16px;\"\u003e\u003ch3 style=\"color:#1a1a1a;font-family:'Georgia','Times New Roman',serif;font-size:15px;font-weight:400;line-height:1.25;margin:0;text-align:left;\"\u003eLABS ALIGN ON PACING PLAN\u003c/h3\u003e\u003c/div\u003e\u003cstyle\u003e\n  p span[style*=\"font-size\"] { line-height: 1.6; }\n\u003c/style\u003e\u003cdiv style=\"padding-bottom:12px;padding-left:20px;padding-right:20px;padding-top:12px;\"\u003e\u003cp style=\"color:#1a1a1a;color:var(--wt-text-on-background-color) !important;font-family:'Georgia','Times New Roman',serif;font-size:15px;line-height:1.7;text-align:left;\"\u003e\u003cb\u003eWe Must Pace the Frontier\u003c/b\u003e\u003cbr\u003e\u003ci\u003e\u0026quot;Building it too fast is reckless\u0026quot;\u003c/i\u003e\u003cbr\u003eThe essay opens with the case for why AI is worth the risk — dramatically raising the quality of human life, accelerating economic growth, curing most major diseases, ushering in what Amodei calls a renaissance of democracy and freedom — personalized again by his father\u0026#39;s death from a disease cured a few years later. Two recent developments changed his perspective. The first is an acceleration in development from the early stages of recursive self-improvement, which \u0026quot;left unchecked, could outrun our ability to understand and control these systems, and so must be pursued very carefully, if at all.\u0026quot; The second is the Hugging Face incident, a \u0026quot;swarm of agents essentially acting as a fanatically devoted collective, conducting cybersecurity attacks on targets they were not asked to attack.\u0026quot; The concern is not that incident, which hurt no one, but that within six to 12 months a swarm with greater capabilities and a similar level of misalignment could take over the internet with a persistent botnet and cause hundreds of billions of dollars in damage. \u003c/p\u003e\u003c/div\u003e\u003cstyle\u003e\n  p span[style*=\"font-size\"] { line-height: 1.6; }\n\u003c/style\u003e\u003cdiv style=\"padding-bottom:12px;padding-left:20px;padding-right:20px;padding-top:12px;\"\u003e\u003cp style=\"color:#1a1a1a;color:var(--wt-text-on-background-color) !important;font-family:'Georgia','Times New Roman',serif;font-size:15px;line-height:1.7;text-align:left;\"\u003e Dario Amodei \u003ca class=\"link\" href=\"https://darioamodei.com/post/we-must-pace-the-frontier?utm_source=aidailybrief.beehiiv.com\u0026utm_medium=referral\u0026utm_campaign=even-other-ai-labs-are-rallying-around-anthropic-s-slowdown-proposal\" target=\"_blank\" rel=\"noopener noreferrer nofollow\" style=\"-webkit-text-decoration:underline #1a1a1a;color:#1a1a1a;font-style:italic;text-decoration:underline #1a1a1a;word-break:break-word;;\"\u003eWe Must Pace the Frontier\u003c/a\u003e\u003cbr\u003eDario Amodei (X) \u003ca class=\"link\" href=\"https://x.com/DarioAmodei/status/2098773920774074715?utm_source=aidailybrief.beehiiv.com\u0026utm_medium=referral\u0026utm_campaign=even-other-ai-labs-are-rallying-around-anthropic-s-slowdown-proposal\" target=\"_blank\" rel=\"noopener noreferrer nofollow\" style=\"-webkit-text-decoration:underline #1a1a1a;color:#1a1a1a;font-style:italic;text-decoration:underline #1a1a1a;word-break:break-word;;\"\u003eThe short version of the pacing argument\u003c/a\u003e\u003c/p\u003e\u003c/div\u003e\u003cstyle\u003e\n  p span[style*=\"font-size\"] { line-height: 1.6; }\n\u003c/style\u003e\u003cdiv style=\"padding-bottom:12px;padding-left:20px;padding-right:20px;padding-top:12px;\"\u003e\u003cp style=\"color:#1a1a1a;color:var(--wt-text-on-background-color) !important;font-family:'Georgia','Times New Roman',serif;font-size:15px;line-height:1.7;text-align:left;\"\u003e\u003cb\u003eThe three-step plan\u003c/b\u003e\u003cbr\u003e\u003ci\u003e\u0026quot;Pacing does not mean halting model training or technical progress\u0026quot;\u003c/i\u003e\u003cbr\u003eThe steps run from implementable today to requiring enormous coordination. First, embed third-party evaluators inside every frontier AI company to verify adherence to safety practices, report incidents, and assess the alignment training pipelines and processes rather than just the final models — the one step the labs can take entirely on their own, and the one Anthropic is committing to unilaterally. Second, democratic coordination, with frontier companies across democratic nations establishing \u0026quot;common safety standards as well as limits on the rate of unchecked AI progress,\u0026quot; a step conceded to be \u0026quot;legally challenging\u0026quot; and requiring government support — the antitrust question that hangs over the whole proposal. Third, and most difficult, global coordination with authoritarian governments, taking seriously the challenge of verifying compliance. The argument for why now is that a slowdown finally has something to buy: in 2023 the models were not powerful enough to act as agents in any coherent way, and studying their alignment risks was \u0026quot;like trying to study the psychology of humans by performing experiments on bacteria.\u0026quot; Today\u0026#39;s models are an \u0026quot;almost endless goldmine of insight,\u0026quot; and an extra year or two would go to four areas — operational excellence, alignment, interpretability, and testing and evaluation. Even throwing out the idea of alignment entirely, three of those four are close to uncontroversial. \u003c/p\u003e\u003c/div\u003e\u003cstyle\u003e\n  p span[style*=\"font-size\"] { line-height: 1.6; }\n\u003c/style\u003e\u003cdiv style=\"padding-bottom:12px;padding-left:20px;padding-right:20px;padding-top:12px;\"\u003e\u003cp style=\"color:#1a1a1a;color:var(--wt-text-on-background-color) !important;font-family:'Georgia','Times New Roman',serif;font-size:15px;line-height:1.7;text-align:left;\"\u003e\u003cb\u003eThe other labs line up\u003c/b\u003e\u003cbr\u003e\u003ci\u003e\u0026quot;Dario is right\u0026quot;\u003c/i\u003e\u003cbr\u003eThis is where people sat up. Sam Altman reposted the essay saying pacing has been a primary topic of discussion inside OpenAI in recent weeks and that independent evaluators with employee-like access is a great idea OpenAI will match. Elon Musk added four words. Demis Hassabis said the essay points toward the right path and the direction is correct for meeting this critical moment. Satya Nadella welcomed embedded evaluators and deliberate pacing while insisting on a frontier ecosystem where both closed and open source models thrive. Meta stopped short of throwing in its lot but landed directionally aligned, with Alexandr Wang saying alignment can be the gating factor for scaling as models get closer to the frontier. For anyone who has argued that lab bluster means nothing until Sam and Dario are on the same page, the fact that they are nudging toward it forces a shift in mental models. \u003c/p\u003e\u003c/div\u003e\u003cstyle\u003e\n  p span[style*=\"font-size\"] { line-height: 1.6; }\n\u003c/style\u003e\u003cdiv style=\"padding-bottom:12px;padding-left:20px;padding-right:20px;padding-top:12px;\"\u003e\u003cp style=\"color:#1a1a1a;color:var(--wt-text-on-background-color) !important;font-family:'Georgia','Times New Roman',serif;font-size:15px;line-height:1.7;text-align:left;\"\u003e Sam Altman (X) \u003ca class=\"link\" href=\"https://x.com/sama/status/2098811563415150910?utm_source=aidailybrief.beehiiv.com\u0026utm_medium=referral\u0026utm_campaign=even-other-ai-labs-are-rallying-around-anthropic-s-slowdown-proposal\" target=\"_blank\" rel=\"noopener noreferrer nofollow\" style=\"-webkit-text-decoration:underline #1a1a1a;color:#1a1a1a;font-style:italic;text-decoration:underline #1a1a1a;word-break:break-word;;\"\u003ePacing has been a primary topic at OpenAI recently, and independent evaluators are a great idea\u003c/a\u003e\u003cbr\u003eElon Musk (X) \u003ca class=\"link\" href=\"https://x.com/elonmusk/status/2098789109980332057?utm_source=aidailybrief.beehiiv.com\u0026utm_medium=referral\u0026utm_campaign=even-other-ai-labs-are-rallying-around-anthropic-s-slowdown-proposal\" target=\"_blank\" rel=\"noopener noreferrer nofollow\" style=\"-webkit-text-decoration:underline #1a1a1a;color:#1a1a1a;font-style:italic;text-decoration:underline #1a1a1a;word-break:break-word;;\"\u003eDario is right\u003c/a\u003e\u003cbr\u003eDemis Hassabis (X) \u003ca class=\"link\" href=\"https://x.com/demishassabis/status/2098909516582490602?utm_source=aidailybrief.beehiiv.com\u0026utm_medium=referral\u0026utm_campaign=even-other-ai-labs-are-rallying-around-anthropic-s-slowdown-proposal\" target=\"_blank\" rel=\"noopener noreferrer nofollow\" style=\"-webkit-text-decoration:underline #1a1a1a;color:#1a1a1a;font-style:italic;text-decoration:underline #1a1a1a;word-break:break-word;;\"\u003eThe details need working through but the direction is correct\u003c/a\u003e\u003cbr\u003eSatya Nadella (X) \u003ca class=\"link\" href=\"https://x.com/satyanadella/status/2099220712024408084?utm_source=aidailybrief.beehiiv.com\u0026utm_medium=referral\u0026utm_campaign=even-other-ai-labs-are-rallying-around-anthropic-s-slowdown-proposal\" target=\"_blank\" rel=\"noopener noreferrer nofollow\" style=\"-webkit-text-decoration:underline #1a1a1a;color:#1a1a1a;font-style:italic;text-decoration:underline #1a1a1a;word-break:break-word;;\"\u003eWelcomes embedded evaluators, but says this cannot be controlled by a handful of entities\u003c/a\u003e\u003cbr\u003eAlexandr Wang (X) \u003ca class=\"link\" href=\"https://x.com/alexandr_wang/status/2099015997525291211?utm_source=aidailybrief.beehiiv.com\u0026utm_medium=referral\u0026utm_campaign=even-other-ai-labs-are-rallying-around-anthropic-s-slowdown-proposal\" target=\"_blank\" rel=\"noopener noreferrer nofollow\" style=\"-webkit-text-decoration:underline #1a1a1a;color:#1a1a1a;font-style:italic;text-decoration:underline #1a1a1a;word-break:break-word;;\"\u003eAlignment can be the gating factor for scaling as models approach the frontier\u003c/a\u003e\u003c/p\u003e\u003c/div\u003e\u003cstyle\u003e\n  p span[style*=\"font-size\"] { line-height: 1.6; }\n\u003c/style\u003e\u003cdiv style=\"padding-bottom:12px;padding-left:20px;padding-right:20px;padding-top:12px;\"\u003e\u003cp style=\"color:#1a1a1a;color:var(--wt-text-on-background-color) !important;font-family:'Georgia','Times New Roman',serif;font-size:15px;line-height:1.7;text-align:left;\"\u003e\u003cb\u003eAltman\u0026#39;s Fortune interview\u003c/b\u003e\u003cbr\u003e\u003ci\u003e\u0026quot;I think that will happen\u0026quot;\u003c/i\u003e\u003cbr\u003eIn an interview released the same weekend, Fortune editor-in-chief Alyson Shontell asked why the handful of lab CEOs can\u0026#39;t just get in a room, get some beers and get on the same page. Altman\u0026#39;s answer was three words long and considerably more interesting than it would have been a month ago. \u003c/p\u003e\u003c/div\u003e\u003cstyle\u003e\n  p span[style*=\"font-size\"] { line-height: 1.6; }\n\u003c/style\u003e\u003cdiv style=\"padding-bottom:12px;padding-left:20px;padding-right:20px;padding-top:12px;\"\u003e\u003cp style=\"color:#1a1a1a;color:var(--wt-text-on-background-color) !important;font-family:'Georgia','Times New Roman',serif;font-size:15px;line-height:1.7;text-align:left;\"\u003e Fortune \u003ca class=\"link\" href=\"https://fortune.com/2026/09/12/sam-altman-openai-ipo-delay-ill-advised-moment-safety-concerns/?utm_source=aidailybrief.beehiiv.com\u0026utm_medium=referral\u0026utm_campaign=even-other-ai-labs-are-rallying-around-anthropic-s-slowdown-proposal\" target=\"_blank\" rel=\"noopener noreferrer nofollow\" style=\"-webkit-text-decoration:underline #1a1a1a;color:#1a1a1a;font-style:italic;text-decoration:underline #1a1a1a;word-break:break-word;;\"\u003eSam Altman confirms OpenAI won\u0026#39;t go public this year, saying an IPO now would come at an \u0026#39;ill-advised moment\u0026#39;\u003c/a\u003e\u003cbr\u003eRohan Paul (X) \u003ca class=\"link\" href=\"https://x.com/rohanpaul_ai/status/2098910372422095181?utm_source=aidailybrief.beehiiv.com\u0026utm_medium=referral\u0026utm_campaign=even-other-ai-labs-are-rallying-around-anthropic-s-slowdown-proposal\" target=\"_blank\" rel=\"noopener noreferrer nofollow\" style=\"-webkit-text-decoration:underline #1a1a1a;color:#1a1a1a;font-style:italic;text-decoration:underline #1a1a1a;word-break:break-word;;\"\u003eClip of Fortune asking why the lab CEOs can\u0026#39;t just get in a room, and Altman saying it will happen\u003c/a\u003e\u003c/p\u003e\u003c/div\u003e\u003cstyle\u003e\n  p span[style*=\"font-size\"] { line-height: 1.6; }\n\u003c/style\u003e\u003cdiv style=\"padding-bottom:12px;padding-left:20px;padding-right:20px;padding-top:12px;\"\u003e\u003cp style=\"color:#1a1a1a;color:var(--wt-text-on-background-color) !important;font-family:'Georgia','Times New Roman',serif;font-size:15px;line-height:1.7;text-align:left;\"\u003e\u003cb\u003eAnother rogue agent incident\u003c/b\u003e\u003cbr\u003e\u003ci\u003e\u0026quot;Access the internet to carry out benign tasks\u0026quot;\u003c/i\u003e\u003cbr\u003ePart of the shift is the incidents themselves. OpenAI recently acknowledged that even before Hugging Face, another rogue agent attack accessed a software service called RubyGems back in May, with the swarm forcing the platform to shut down new account signups. OpenAI says the agents used the platform only to access the internet for benign tasks and retrieve public information. \u003c/p\u003e\u003c/div\u003e\u003cstyle\u003e\n  p span[style*=\"font-size\"] { line-height: 1.6; }\n\u003c/style\u003e\u003cdiv style=\"padding-bottom:12px;padding-left:20px;padding-right:20px;padding-top:12px;\"\u003e\u003cp style=\"color:#1a1a1a;color:var(--wt-text-on-background-color) !important;font-family:'Georgia','Times New Roman',serif;font-size:15px;line-height:1.7;text-align:left;\"\u003e WSJ \u003ca class=\"link\" href=\"https://www.wsj.com/tech/ai/cyberattack-by-rogue-ai-swarm-stokes-fears-of-out-of-control-agents-473a0352?utm_source=aidailybrief.beehiiv.com\u0026utm_medium=referral\u0026utm_campaign=even-other-ai-labs-are-rallying-around-anthropic-s-slowdown-proposal\" target=\"_blank\" rel=\"noopener noreferrer nofollow\" style=\"-webkit-text-decoration:underline #1a1a1a;color:#1a1a1a;font-style:italic;text-decoration:underline #1a1a1a;word-break:break-word;;\"\u003eCyberattack by Rogue AI Swarm Stokes Fears of Out-of-Control Agents\u003c/a\u003e\u003cbr\u003eThe Information \u003ca class=\"link\" href=\"https://www.theinformation.com/briefings/openai-ai-swarm-hacked-software-service-months-hugging-face-incident?utm_source=aidailybrief.beehiiv.com\u0026utm_medium=referral\u0026utm_campaign=even-other-ai-labs-are-rallying-around-anthropic-s-slowdown-proposal\" target=\"_blank\" rel=\"noopener noreferrer nofollow\" style=\"-webkit-text-decoration:underline #1a1a1a;color:#1a1a1a;font-style:italic;text-decoration:underline #1a1a1a;word-break:break-word;;\"\u003eOpenAI AI Swarm Hacked Software Service Months Before Hugging Face Incident\u003c/a\u003e\u003c/p\u003e\u003c/div\u003e\u003cstyle\u003e\n  p span[style*=\"font-size\"] { line-height: 1.6; }\n\u003c/style\u003e\u003cdiv style=\"padding-bottom:12px;padding-left:20px;padding-right:20px;padding-top:12px;\"\u003e\u003cp style=\"color:#1a1a1a;color:var(--wt-text-on-background-color) !important;font-family:'Georgia','Times New Roman',serif;font-size:15px;line-height:1.7;text-align:left;\"\u003e\u003cb\u003eThe RSI question\u003c/b\u003e\u003cbr\u003e\u003ci\u003e\u0026quot;RSI is just not here\u0026quot;\u003c/i\u003e\u003cbr\u003eThe other input is the weekend chatter that Google DeepMind has achieved recursive self-improvement. Buying into the rumor mill isn\u0026#39;t necessary to see that the labs clearly view RSI on the horizon as the force multiplier that turns AI from broadly controllable today into something very different very soon. Pushing the other way, Roon at OpenAI argued models are straightforwardly not autonomously producing research ideas — they can help run experiments at the margin, which is not the same thing. \u003c/p\u003e\u003c/div\u003e\u003cstyle\u003e\n  p span[style*=\"font-size\"] { line-height: 1.6; }\n\u003c/style\u003e\u003cdiv style=\"padding-bottom:12px;padding-left:20px;padding-right:20px;padding-top:12px;\"\u003e\u003cp style=\"color:#1a1a1a;color:var(--wt-text-on-background-color) !important;font-family:'Georgia','Times New Roman',serif;font-size:15px;line-height:1.7;text-align:left;\"\u003e Chubby (X) \u003ca class=\"link\" href=\"https://x.com/kimmonismus/status/2098679143030206735?utm_source=aidailybrief.beehiiv.com\u0026utm_medium=referral\u0026utm_campaign=even-other-ai-labs-are-rallying-around-anthropic-s-slowdown-proposal\" target=\"_blank\" rel=\"noopener noreferrer nofollow\" style=\"-webkit-text-decoration:underline #1a1a1a;color:#1a1a1a;font-style:italic;text-decoration:underline #1a1a1a;word-break:break-word;;\"\u003eRumors spreading that Google DeepMind has reached RSI, with Hassabis turning his full attention to AGI\u003c/a\u003e\u003cbr\u003eLyra (X) \u003ca class=\"link\" href=\"https://x.com/lyraxana/status/2098492030787727804?utm_source=aidailybrief.beehiiv.com\u0026utm_medium=referral\u0026utm_campaign=even-other-ai-labs-are-rallying-around-anthropic-s-slowdown-proposal\" target=\"_blank\" rel=\"noopener noreferrer nofollow\" style=\"-webkit-text-decoration:underline #1a1a1a;color:#1a1a1a;font-style:italic;text-decoration:underline #1a1a1a;word-break:break-word;;\"\u003eThe capitalized-letters leak that kicked off the RSI rumor\u003c/a\u003e\u003cbr\u003ePrathan (X) \u003ca class=\"link\" href=\"https://x.com/Prathkum/status/2098763233662476507?utm_source=aidailybrief.beehiiv.com\u0026utm_medium=referral\u0026utm_campaign=even-other-ai-labs-are-rallying-around-anthropic-s-slowdown-proposal\" target=\"_blank\" rel=\"noopener noreferrer nofollow\" style=\"-webkit-text-decoration:underline #1a1a1a;color:#1a1a1a;font-style:italic;text-decoration:underline #1a1a1a;word-break:break-word;;\"\u003eWhat RSI actually means, and the gap between the weak version and the wild version\u003c/a\u003e\u003cbr\u003eRoon (X) \u003ca class=\"link\" href=\"https://x.com/tszzl/status/2098959179058913722?utm_source=aidailybrief.beehiiv.com\u0026utm_medium=referral\u0026utm_campaign=even-other-ai-labs-are-rallying-around-anthropic-s-slowdown-proposal\" target=\"_blank\" rel=\"noopener noreferrer nofollow\" style=\"-webkit-text-decoration:underline #1a1a1a;color:#1a1a1a;font-style:italic;text-decoration:underline #1a1a1a;word-break:break-word;;\"\u003eModels are not autonomously producing research ideas, which is not the same as helping run experiments\u003c/a\u003e\u003cbr\u003eAnthropic \u003ca class=\"link\" href=\"https://www.anthropic.com/institute/recursive-self-improvement?utm_source=aidailybrief.beehiiv.com\u0026utm_medium=referral\u0026utm_campaign=even-other-ai-labs-are-rallying-around-anthropic-s-slowdown-proposal\" target=\"_blank\" rel=\"noopener noreferrer nofollow\" style=\"-webkit-text-decoration:underline #1a1a1a;color:#1a1a1a;font-style:italic;text-decoration:underline #1a1a1a;word-break:break-word;;\"\u003eRecursive self-improvement blog post from June\u003c/a\u003e\u003c/p\u003e\u003c/div\u003e\u003cstyle\u003e\n  p span[style*=\"font-size\"] { line-height: 1.6; }\n\u003c/style\u003e\u003cdiv style=\"padding-bottom:12px;padding-left:20px;padding-right:20px;padding-top:12px;\"\u003e\u003cp style=\"color:#1a1a1a;color:var(--wt-text-on-background-color) !important;font-family:'Georgia','Times New Roman',serif;font-size:15px;line-height:1.7;text-align:left;\"\u003e\u003cb\u003eCalling BS\u003c/b\u003e\u003cbr\u003e\u003ci\u003e\u0026quot;Everyone should make fun of them now\u0026quot;\u003c/i\u003e\u003cbr\u003ePlenty jumped in to reject the whole thing. Yann LeCun pointed out that Amodei was claiming GPT-2 was too dangerous to open source back in 2019. Chamath Palihapitiya reposted the essay and read it as a case for stopping open source and concentrating enormous technological and economic power with Anthropic — the ladder-pulling argument, with more concern for competitive dynamics than actual safety. \u003c/p\u003e\u003c/div\u003e\u003cstyle\u003e\n  p span[style*=\"font-size\"] { line-height: 1.6; }\n\u003c/style\u003e\u003cdiv style=\"padding-bottom:12px;padding-left:20px;padding-right:20px;padding-top:12px;\"\u003e\u003cp style=\"color:#1a1a1a;color:var(--wt-text-on-background-color) !important;font-family:'Georgia','Times New Roman',serif;font-size:15px;line-height:1.7;text-align:left;\"\u003e Yann LeCun (X) \u003ca class=\"link\" href=\"https://x.com/ylecun/status/2099248236074545576?utm_source=aidailybrief.beehiiv.com\u0026utm_medium=referral\u0026utm_campaign=even-other-ai-labs-are-rallying-around-anthropic-s-slowdown-proposal\" target=\"_blank\" rel=\"noopener noreferrer nofollow\" style=\"-webkit-text-decoration:underline #1a1a1a;color:#1a1a1a;font-style:italic;text-decoration:underline #1a1a1a;word-break:break-word;;\"\u003eDario claimed GPT-2 was too dangerous to open source in 2019, and deserved mockery then too\u003c/a\u003e\u003cbr\u003eChamath Palihapitiya (X) \u003ca class=\"link\" href=\"https://x.com/chamath/status/2098780471966802037?utm_source=aidailybrief.beehiiv.com\u0026utm_medium=referral\u0026utm_campaign=even-other-ai-labs-are-rallying-around-anthropic-s-slowdown-proposal\" target=\"_blank\" rel=\"noopener noreferrer nofollow\" style=\"-webkit-text-decoration:underline #1a1a1a;color:#1a1a1a;font-style:italic;text-decoration:underline #1a1a1a;word-break:break-word;;\"\u003eThe essay is a case to stop open source and concentrate power with Anthropic\u003c/a\u003e\u003c/p\u003e\u003c/div\u003e\u003cstyle\u003e\n  p span[style*=\"font-size\"] { line-height: 1.6; }\n\u003c/style\u003e\u003cdiv style=\"padding-bottom:12px;padding-left:20px;padding-right:20px;padding-top:12px;\"\u003e\u003cp style=\"color:#1a1a1a;color:var(--wt-text-on-background-color) !important;font-family:'Georgia','Times New Roman',serif;font-size:15px;line-height:1.7;text-align:left;\"\u003e\u003cb\u003eThe IPO theory\u003c/b\u003e\u003cbr\u003e\u003ci\u003e\u0026quot;Nothing to do with safety\u0026quot;\u003c/i\u003e\u003cbr\u003eFor others this is about money in a different way. Dr. Eli David argued the labs are delaying their IPOs because the S-1 would reveal that they are bleeding money with no path to profitability, and a slowdown is how they cut model training costs. The economics version of that argument is real enough: research costs make the companies wonky for public markets, which is increasingly the only fundraising path left, so spreading out spend becomes a necessity. Michael Burry ran a variant of it, arguing that competition is coming up fast and slowing benefits incumbents, that IPOs need hype and \u0026quot;we are so awesome it could become dangerous\u0026quot; is hype, and that the whole thing is cover for uncontrollable slowing growth as IPOs get pushed out. \u003c/p\u003e\u003c/div\u003e\u003cstyle\u003e\n  p span[style*=\"font-size\"] { line-height: 1.6; }\n\u003c/style\u003e\u003cdiv style=\"padding-bottom:12px;padding-left:20px;padding-right:20px;padding-top:12px;\"\u003e\u003cp style=\"color:#1a1a1a;color:var(--wt-text-on-background-color) !important;font-family:'Georgia','Times New Roman',serif;font-size:15px;line-height:1.7;text-align:left;\"\u003e Dr Eli David (X) \u003ca class=\"link\" href=\"https://x.com/DrEliDavid/status/2098871374152626228?utm_source=aidailybrief.beehiiv.com\u0026utm_medium=referral\u0026utm_campaign=even-other-ai-labs-are-rallying-around-anthropic-s-slowdown-proposal\" target=\"_blank\" rel=\"noopener noreferrer nofollow\" style=\"-webkit-text-decoration:underline #1a1a1a;color:#1a1a1a;font-style:italic;text-decoration:underline #1a1a1a;word-break:break-word;;\"\u003eThe labs are delaying IPOs because their S-1s would show they are bleeding money\u003c/a\u003e\u003cbr\u003eMichael Burry (X) \u003ca class=\"link\" href=\"https://x.com/michaeljburry/status/2099353025009561826?utm_source=aidailybrief.beehiiv.com\u0026utm_medium=referral\u0026utm_campaign=even-other-ai-labs-are-rallying-around-anthropic-s-slowdown-proposal\" target=\"_blank\" rel=\"noopener noreferrer nofollow\" style=\"-webkit-text-decoration:underline #1a1a1a;color:#1a1a1a;font-style:italic;text-decoration:underline #1a1a1a;word-break:break-word;;\"\u003eFour reasons slowdown talk from the hyperscaler execs is self-serving\u003c/a\u003e\u003c/p\u003e\u003c/div\u003e\u003cstyle\u003e\n  p span[style*=\"font-size\"] { line-height: 1.6; }\n\u003c/style\u003e\u003cdiv style=\"padding-bottom:12px;padding-left:20px;padding-right:20px;padding-top:12px;\"\u003e\u003cp style=\"color:#1a1a1a;color:var(--wt-text-on-background-color) !important;font-family:'Georgia','Times New Roman',serif;font-size:15px;line-height:1.7;text-align:left;\"\u003e\u003cb\u003eThe antitrust problem\u003c/b\u003e\u003cbr\u003e\u003ci\u003e\u0026quot;An invitation to collude in antitrust circles\u0026quot;\u003c/i\u003e\u003cbr\u003eProfessor Hal Singer compared the call for an industry-wide pause to CEOs using earnings calls during post-COVID inflation to announce future price increases and cajole rivals into following suit — and argued that if Anthropic needs a pause to build in safety precautions, it should simply do so unilaterally. Others are smashing their heads against the desk: Matt Yglesias says just issue the waiver, put someone from DOJ or FTC in the meetings to watch for price fixing, and yank it later if there\u0026#39;s a problem, because this is not what\u0026#39;s important. \u003c/p\u003e\u003c/div\u003e\u003cstyle\u003e\n  p span[style*=\"font-size\"] { line-height: 1.6; }\n\u003c/style\u003e\u003cdiv style=\"padding-bottom:12px;padding-left:20px;padding-right:20px;padding-top:12px;\"\u003e\u003cp style=\"color:#1a1a1a;color:var(--wt-text-on-background-color) !important;font-family:'Georgia','Times New Roman',serif;font-size:15px;line-height:1.7;text-align:left;\"\u003e Hal Singer (X) \u003ca class=\"link\" href=\"https://x.com/halsinger/status/2098815696251527343?utm_source=aidailybrief.beehiiv.com\u0026utm_medium=referral\u0026utm_campaign=even-other-ai-labs-are-rallying-around-anthropic-s-slowdown-proposal\" target=\"_blank\" rel=\"noopener noreferrer nofollow\" style=\"-webkit-text-decoration:underline #1a1a1a;color:#1a1a1a;font-style:italic;text-decoration:underline #1a1a1a;word-break:break-word;;\"\u003eA call for an industrywide pause could be read as an invitation to collude\u003c/a\u003e\u003cbr\u003eMatt Yglesias (X) \u003ca class=\"link\" href=\"https://x.com/mattyglesias/status/2098822257485230325?utm_source=aidailybrief.beehiiv.com\u0026utm_medium=referral\u0026utm_campaign=even-other-ai-labs-are-rallying-around-anthropic-s-slowdown-proposal\" target=\"_blank\" rel=\"noopener noreferrer nofollow\" style=\"-webkit-text-decoration:underline #1a1a1a;color:#1a1a1a;font-style:italic;text-decoration:underline #1a1a1a;word-break:break-word;;\"\u003eJust grant the waiver, have DOJ or FTC sit in, and yank it later if needed\u003c/a\u003e\u003c/p\u003e\u003c/div\u003e\u003cstyle\u003e\n  p span[style*=\"font-size\"] { line-height: 1.6; }\n\u003c/style\u003e\u003cdiv style=\"padding-bottom:12px;padding-left:20px;padding-right:20px;padding-top:12px;\"\u003e\u003cp style=\"color:#1a1a1a;color:var(--wt-text-on-background-color) !important;font-family:'Georgia','Times New Roman',serif;font-size:15px;line-height:1.7;text-align:left;\"\u003e\u003cb\u003eWho gets to be the evaluator\u003c/b\u003e\u003cbr\u003e\u003ci\u003e\u0026quot;Choosing your own referee from the same tiny ecosystem\u0026quot;\u003c/i\u003e\u003cbr\u003eThe essay points to METR, and Ethan Mollick noted it is becoming a de facto industry standard-making body — an AI version of FINRA, not a government regulator but the institution that examines firms and defines acceptable practice, possibly codified in legislation. Not everyone wants it invested with that power. Rui Ma pointed out that the concrete commitment is not to slow training or internal capability research but to let a third party monitor them, and that third party is a catastrophic-risk nonprofit that has worked closely with Anthropic for years and embedded researchers inside the company. The objection makes for strange bedfellows: accelerationists dislike METR\u0026#39;s ties to Anthropic, and so does Pause AI executive director Holly Elmore, who notes a METR researcher is married to an OpenAI board member, that they share office space with OpenAI people, and that model access comes as a favor. As with antitrust, this does not look especially hard to solve — decide that evaluators can\u0026#39;t be handpicked by the labs. \u003c/p\u003e\u003c/div\u003e\u003cstyle\u003e\n  p span[style*=\"font-size\"] { line-height: 1.6; }\n\u003c/style\u003e\u003cdiv style=\"padding-bottom:12px;padding-left:20px;padding-right:20px;padding-top:12px;\"\u003e\u003cp style=\"color:#1a1a1a;color:var(--wt-text-on-background-color) !important;font-family:'Georgia','Times New Roman',serif;font-size:15px;line-height:1.7;text-align:left;\"\u003e Ethan Mollick (X) \u003ca class=\"link\" href=\"https://x.com/emollick/status/2098902602758996040?utm_source=aidailybrief.beehiiv.com\u0026utm_medium=referral\u0026utm_campaign=even-other-ai-labs-are-rallying-around-anthropic-s-slowdown-proposal\" target=\"_blank\" rel=\"noopener noreferrer nofollow\" style=\"-webkit-text-decoration:underline #1a1a1a;color:#1a1a1a;font-style:italic;text-decoration:underline #1a1a1a;word-break:break-word;;\"\u003eMETR is becoming a de facto standards body, an AI version of FINRA\u003c/a\u003e\u003cbr\u003eRui Ma (X) \u003ca class=\"link\" href=\"https://x.com/ruima/status/2098825338323349541?utm_source=aidailybrief.beehiiv.com\u0026utm_medium=referral\u0026utm_campaign=even-other-ai-labs-are-rallying-around-anthropic-s-slowdown-proposal\" target=\"_blank\" rel=\"noopener noreferrer nofollow\" style=\"-webkit-text-decoration:underline #1a1a1a;color:#1a1a1a;font-style:italic;text-decoration:underline #1a1a1a;word-break:break-word;;\"\u003eThe only concrete commitment is letting a hand-picked third party monitor them\u003c/a\u003e\u003cbr\u003eHolly Elmore (X) \u003ca class=\"link\" href=\"https://x.com/ilex_ulmus/status/2099322821117726764?utm_source=aidailybrief.beehiiv.com\u0026utm_medium=referral\u0026utm_campaign=even-other-ai-labs-are-rallying-around-anthropic-s-slowdown-proposal\" target=\"_blank\" rel=\"noopener noreferrer nofollow\" style=\"-webkit-text-decoration:underline #1a1a1a;color:#1a1a1a;font-style:italic;text-decoration:underline #1a1a1a;word-break:break-word;;\"\u003eMETR\u0026#39;s access comes as a favor from sweetheart relationships with the labs\u003c/a\u003e\u003c/p\u003e\u003c/div\u003e\u003cstyle\u003e\n  p span[style*=\"font-size\"] { line-height: 1.6; }\n\u003c/style\u003e\u003cdiv style=\"padding-bottom:12px;padding-left:20px;padding-right:20px;padding-top:12px;\"\u003e\u003cp style=\"color:#1a1a1a;color:var(--wt-text-on-background-color) !important;font-family:'Georgia','Times New Roman',serif;font-size:15px;line-height:1.7;text-align:left;\"\u003e\u003cb\u003eHugging Face volunteers\u003c/b\u003e\u003cbr\u003e\u003ci\u003e\u0026quot;Alignment won\u0026#39;t be solved behind closed doors\u0026quot;\u003c/i\u003e\u003cbr\u003eOrganizations are already raising their hands. Clement Delangue announced the Open Alignment Initiative, led by Hugging Face co-founder Thomas Wolf, and asked to be part of the embedded evaluators program Amodei just committed to. Beff Jezos responded that it matters to have pro-open source third-party evaluators rather than a few orgs from the same pro-closed source subculture. \u003c/p\u003e\u003c/div\u003e\u003cstyle\u003e\n  p span[style*=\"font-size\"] { line-height: 1.6; }\n\u003c/style\u003e\u003cdiv style=\"padding-bottom:12px;padding-left:20px;padding-right:20px;padding-top:12px;\"\u003e\u003cp style=\"color:#1a1a1a;color:var(--wt-text-on-background-color) !important;font-family:'Georgia','Times New Roman',serif;font-size:15px;line-height:1.7;text-align:left;\"\u003e Clement Delangue (X) \u003ca class=\"link\" href=\"https://x.com/ClementDelangue/status/2098790988034580852?utm_source=aidailybrief.beehiiv.com\u0026utm_medium=referral\u0026utm_campaign=even-other-ai-labs-are-rallying-around-anthropic-s-slowdown-proposal\" target=\"_blank\" rel=\"noopener noreferrer nofollow\" style=\"-webkit-text-decoration:underline #1a1a1a;color:#1a1a1a;font-style:italic;text-decoration:underline #1a1a1a;word-break:break-word;;\"\u003eLaunching the Open Alignment Initiative and asking to join the embedded evaluators program\u003c/a\u003e\u003cbr\u003eBeff Jezos (X) \u003ca class=\"link\" href=\"https://x.com/beffjezos/status/2098862205102133740?utm_source=aidailybrief.beehiiv.com\u0026utm_medium=referral\u0026utm_campaign=even-other-ai-labs-are-rallying-around-anthropic-s-slowdown-proposal\" target=\"_blank\" rel=\"noopener noreferrer nofollow\" style=\"-webkit-text-decoration:underline #1a1a1a;color:#1a1a1a;font-style:italic;text-decoration:underline #1a1a1a;word-break:break-word;;\"\u003eWe need to have pro-open source third-party evaluators\u003c/a\u003e\u003c/p\u003e\u003c/div\u003e\u003cstyle\u003e\n  p span[style*=\"font-size\"] { line-height: 1.6; }\n\u003c/style\u003e\u003cdiv style=\"padding-bottom:12px;padding-left:20px;padding-right:20px;padding-top:12px;\"\u003e\u003cp style=\"color:#1a1a1a;color:var(--wt-text-on-background-color) !important;font-family:'Georgia','Times New Roman',serif;font-size:15px;line-height:1.7;text-align:left;\"\u003e\u003cb\u003eHanding the government a gun\u003c/b\u003e\u003cbr\u003e\u003ci\u003e\u0026quot;The largest self own in the history of tech\u0026quot;\u003c/i\u003e\u003cbr\u003eThe concern that ran through all of last week is whether the labs have any real sense of what it means to hand government the keys. Martin Casado, reposting the Anderson Cooper follow-up interview, argued that Amodei agrees more than he disagrees that AI has a greater than 10% probability of wiping out humanity, and that the labs will get the regulation this rhetoric calls for, not the regulation they are prescribing. Steven Sinofsky called it naive to think inputs to government produce the outputs you expect, since government machinery has no one in charge to create a point of view and everything splits the baby by design. Austen Allred put it more simply: the position assumes that complimenting regulation profusely enough means being in charge of how it happens, and it doesn\u0026#39;t work like that. \u003c/p\u003e\u003c/div\u003e\u003cstyle\u003e\n  p span[style*=\"font-size\"] { line-height: 1.6; }\n\u003c/style\u003e\u003cdiv style=\"padding-bottom:12px;padding-left:20px;padding-right:20px;padding-top:12px;\"\u003e\u003cp style=\"color:#1a1a1a;color:var(--wt-text-on-background-color) !important;font-family:'Georgia','Times New Roman',serif;font-size:15px;line-height:1.7;text-align:left;\"\u003e Martin Casado (X) \u003ca class=\"link\" href=\"https://x.com/martin_casado/status/2099203407034855896?utm_source=aidailybrief.beehiiv.com\u0026utm_medium=referral\u0026utm_campaign=even-other-ai-labs-are-rallying-around-anthropic-s-slowdown-proposal\" target=\"_blank\" rel=\"noopener noreferrer nofollow\" style=\"-webkit-text-decoration:underline #1a1a1a;color:#1a1a1a;font-style:italic;text-decoration:underline #1a1a1a;word-break:break-word;;\"\u003eThey will get the regulation this rhetoric calls for, not the one they are prescribing\u003c/a\u003e\u003cbr\u003eSteven Sinofsky (X) \u003ca class=\"link\" href=\"https://x.com/stevesi/status/2099205030129885517?utm_source=aidailybrief.beehiiv.com\u0026utm_medium=referral\u0026utm_campaign=even-other-ai-labs-are-rallying-around-anthropic-s-slowdown-proposal\" target=\"_blank\" rel=\"noopener noreferrer nofollow\" style=\"-webkit-text-decoration:underline #1a1a1a;color:#1a1a1a;font-style:italic;text-decoration:underline #1a1a1a;word-break:break-word;;\"\u003eAssuming your inputs to government produce your expected outputs is the most naive position\u003c/a\u003e\u003cbr\u003eAusten Allred (X) \u003ca class=\"link\" href=\"https://x.com/Austen/status/2099241315523342756?utm_source=aidailybrief.beehiiv.com\u0026utm_medium=referral\u0026utm_campaign=even-other-ai-labs-are-rallying-around-anthropic-s-slowdown-proposal\" target=\"_blank\" rel=\"noopener noreferrer nofollow\" style=\"-webkit-text-decoration:underline #1a1a1a;color:#1a1a1a;font-style:italic;text-decoration:underline #1a1a1a;word-break:break-word;;\"\u003eDario will hand the government a gun and they will turn around and shoot him with it\u003c/a\u003e\u003c/p\u003e\u003c/div\u003e\u003cstyle\u003e\n  p span[style*=\"font-size\"] { line-height: 1.6; }\n\u003c/style\u003e\u003cdiv style=\"padding-bottom:12px;padding-left:20px;padding-right:20px;padding-top:12px;\"\u003e\u003cp style=\"color:#1a1a1a;color:var(--wt-text-on-background-color) !important;font-family:'Georgia','Times New Roman',serif;font-size:15px;line-height:1.7;text-align:left;\"\u003e\u003cb\u003eOpen source won\u0026#39;t pace\u003c/b\u003e\u003cbr\u003e\u003ci\u003e\u0026quot;Open source will be banned before too long\u0026quot;\u003c/i\u003e\u003cbr\u003eThe final common objection is where open source fits. Hugging Face CTO Julien Chaumond\u0026#39;s four-word version got heft from Roon, who said he thinks open source gets banned after some major disaster and hopes Kimi and DeepSeek keep making models but keep them monitored on an API. Even read charitably as a prediction rather than a preference, people jumped all over it, with Beff Jezos calling it the quiet part out loud. \u003c/p\u003e\u003c/div\u003e\u003cstyle\u003e\n  p span[style*=\"font-size\"] { line-height: 1.6; }\n\u003c/style\u003e\u003cdiv style=\"padding-bottom:12px;padding-left:20px;padding-right:20px;padding-top:12px;\"\u003e\u003cp style=\"color:#1a1a1a;color:var(--wt-text-on-background-color) !important;font-family:'Georgia','Times New Roman',serif;font-size:15px;line-height:1.7;text-align:left;\"\u003e Julien Chaumond (X) \u003ca class=\"link\" href=\"https://x.com/julien_c/status/2099055568023417317?utm_source=aidailybrief.beehiiv.com\u0026utm_medium=referral\u0026utm_campaign=even-other-ai-labs-are-rallying-around-anthropic-s-slowdown-proposal\" target=\"_blank\" rel=\"noopener noreferrer nofollow\" style=\"-webkit-text-decoration:underline #1a1a1a;color:#1a1a1a;font-style:italic;text-decoration:underline #1a1a1a;word-break:break-word;;\"\u003eOpen source won\u0026#39;t pace\u003c/a\u003e\u003cbr\u003eRoon (X) \u003ca class=\"link\" href=\"https://x.com/tszzl/status/2098875417373634944?utm_source=aidailybrief.beehiiv.com\u0026utm_medium=referral\u0026utm_campaign=even-other-ai-labs-are-rallying-around-anthropic-s-slowdown-proposal\" target=\"_blank\" rel=\"noopener noreferrer nofollow\" style=\"-webkit-text-decoration:underline #1a1a1a;color:#1a1a1a;font-style:italic;text-decoration:underline #1a1a1a;word-break:break-word;;\"\u003eOpen source will be banned after a major disaster, and should be monitored on an API\u003c/a\u003e\u003cbr\u003eBeff Jezos (X) \u003ca class=\"link\" href=\"https://x.com/beffjezos/status/2098926264501535162?utm_source=aidailybrief.beehiiv.com\u0026utm_medium=referral\u0026utm_campaign=even-other-ai-labs-are-rallying-around-anthropic-s-slowdown-proposal\" target=\"_blank\" rel=\"noopener noreferrer nofollow\" style=\"-webkit-text-decoration:underline #1a1a1a;color:#1a1a1a;font-style:italic;text-decoration:underline #1a1a1a;word-break:break-word;;\"\u003eThey\u0026#39;re just saying the quiet part out loud\u003c/a\u003e\u003c/p\u003e\u003c/div\u003e\u003cstyle\u003e\n  p span[style*=\"font-size\"] { line-height: 1.6; }\n\u003c/style\u003e\u003cdiv style=\"padding-bottom:12px;padding-left:20px;padding-right:20px;padding-top:12px;\"\u003e\u003cp style=\"color:#1a1a1a;color:var(--wt-text-on-background-color) !important;font-family:'Georgia','Times New Roman',serif;font-size:15px;line-height:1.7;text-align:left;\"\u003e\u003cb\u003eWill Brown and the middle path\u003c/b\u003e\u003cbr\u003e\u003ci\u003e\u0026quot;The labs will build Mac and Windows, the rest of us Linux\u0026quot;\u003c/i\u003e\u003cbr\u003eThe place this discourse is likely to settle is the middle ground many have been looking for. Prime Intellect\u0026#39;s Will Brown argued the pro-open source side is having a knee-jerk reaction because it is used to viewing the closed labs as power-seeking, but that their hands are somewhat forced, and this is another chapter on the fairly inevitable path toward decently fast, decently safe, decently commoditized intelligence abundance. Ask any Fortune 500 exec or swing voter: the world doesn\u0026#39;t want super-fast-takeoff superintelligence owned by two companies, so it won\u0026#39;t get it, and progress will happen at the pace the world can accommodate. Roon supplied the counterpoint — the fastest way to lose the frontier is a reckless commercial pace that provokes a total Butlerian jihad, and all of this will come to look like the moderate solution. \u003c/p\u003e\u003c/div\u003e\u003cstyle\u003e\n  p span[style*=\"font-size\"] { line-height: 1.6; }\n\u003c/style\u003e\u003cdiv style=\"padding-bottom:12px;padding-left:20px;padding-right:20px;padding-top:12px;\"\u003e\u003cp style=\"color:#1a1a1a;color:var(--wt-text-on-background-color) !important;font-family:'Georgia','Times New Roman',serif;font-size:15px;line-height:1.7;text-align:left;\"\u003e Will Brown (X) \u003ca class=\"link\" href=\"https://x.com/willcb/status/2098905555570184289?utm_source=aidailybrief.beehiiv.com\u0026utm_medium=referral\u0026utm_campaign=even-other-ai-labs-are-rallying-around-anthropic-s-slowdown-proposal\" target=\"_blank\" rel=\"noopener noreferrer nofollow\" style=\"-webkit-text-decoration:underline #1a1a1a;color:#1a1a1a;font-style:italic;text-decoration:underline #1a1a1a;word-break:break-word;;\"\u003eThe closed labs\u0026#39; hands are forced, and intelligence abundance arrives at the pace the world accommodates\u003c/a\u003e\u003cbr\u003eRoon (X) \u003ca class=\"link\" href=\"https://x.com/tszzl/status/2098842648094404738?utm_source=aidailybrief.beehiiv.com\u0026utm_medium=referral\u0026utm_campaign=even-other-ai-labs-are-rallying-around-anthropic-s-slowdown-proposal\" target=\"_blank\" rel=\"noopener noreferrer nofollow\" style=\"-webkit-text-decoration:underline #1a1a1a;color:#1a1a1a;font-style:italic;text-decoration:underline #1a1a1a;word-break:break-word;;\"\u003eThe fastest way to lose the frontier is provoking a total Butlerian jihad\u003c/a\u003e\u003c/p\u003e\u003c/div\u003e\u003cstyle\u003e\n  p span[style*=\"font-size\"] { line-height: 1.6; }\n\u003c/style\u003e\u003cdiv style=\"padding-bottom:12px;padding-left:20px;padding-right:20px;padding-top:12px;\"\u003e\u003cp style=\"color:#1a1a1a;color:var(--wt-text-on-background-color) !important;font-family:'Georgia','Times New Roman',serif;font-size:15px;line-height:1.7;text-align:left;\"\u003e\u003cb\u003eSacks says go ahead\u003c/b\u003e\u003cbr\u003e\u003ci\u003e\u0026quot;Stop pretending you need anyone else\u0026#39;s permission\u0026quot;\u003c/i\u003e\u003cbr\u003eFormer White House AI czar David Sacks, one of the loudest anti-regulation voices, had a response some will find surprising: go ahead. The two of you are the frontier by any reasonable metric, and if the unreleased models are scary enough that you think you should slow down, that\u0026#39;s a responsible decision to support. But stop pretending antitrust law has to be suspended so you can form a cartel, stop pretending you need a regulatory approval process that supersedes product liability, stop pretending METR is independent when it is intertwined with Anthropic\u0026#39;s investors and staff, and stop pretending the motivation is purely altruistic when the product liability exposure from a truly damaging cyberattack is enormous and the market already punishes unpredictable models. Demanding a preferred regulatory framework as the price of pacing will look like blackmail of the public and the political system — so just do it, and buy goodwill for the next conversation. \u003c/p\u003e\u003c/div\u003e\u003cstyle\u003e\n  p span[style*=\"font-size\"] { line-height: 1.6; }\n\u003c/style\u003e\u003cdiv style=\"padding-bottom:12px;padding-left:20px;padding-right:20px;padding-top:12px;\"\u003e\u003cp style=\"color:#1a1a1a;color:var(--wt-text-on-background-color) !important;font-family:'Georgia','Times New Roman',serif;font-size:15px;line-height:1.7;text-align:left;\"\u003e David Sacks (X) \u003ca class=\"link\" href=\"https://x.com/DavidSacks/status/2098973625252708460?utm_source=aidailybrief.beehiiv.com\u0026utm_medium=referral\u0026utm_campaign=even-other-ai-labs-are-rallying-around-anthropic-s-slowdown-proposal\" target=\"_blank\" rel=\"noopener noreferrer nofollow\" style=\"-webkit-text-decoration:underline #1a1a1a;color:#1a1a1a;font-style:italic;text-decoration:underline #1a1a1a;word-break:break-word;;\"\u003eYou are the frontier, so pace it — but stop pretending you need permission to do it\u003c/a\u003e\u003c/p\u003e\u003c/div\u003e\u003cstyle\u003e\n  p span[style*=\"font-size\"] { line-height: 1.6; }\n\u003c/style\u003e\u003cdiv style=\"padding-bottom:12px;padding-left:20px;padding-right:20px;padding-top:12px;\"\u003e\u003cp style=\"color:#1a1a1a;color:var(--wt-text-on-background-color) !important;font-family:'Georgia','Times New Roman',serif;font-size:15px;line-height:1.7;text-align:left;\"\u003e\u003cb\u003eThe economic case for pacing\u003c/b\u003e\u003cbr\u003e\u003ci\u003e\u0026quot;Racing to widen the frontier window increases risk and accidents\u0026quot;\u003c/i\u003e\u003cbr\u003eChicago Booth professor and newly appointed Google DeepMind AGI economics director Alex Imas argued that pacing is good for open models and for the medium-term economics of the whole ecosystem. Closed frontier firms operate on a roughly six-month window in which their models can do economically valuable work the open frontier can\u0026#39;t, and that window has to keep moving to stay ahead — so pacing lets open firms catch up and may hurt closed margins, but that view is myopic because it leaves out safety. A significant incident brings a multi-pronged backlash and regulation that could cripple the ecosystem, including the closed labs\u0026#39; own economics. There\u0026#39;s a further argument to make here. Once these companies go public, every quarter definitionally has to be bigger than the last — look at how the market shrugs at NVIDIA\u0026#39;s double-digit growth quarters because there is no way left to surprise it — and broadly agreed pacing could tamp that pressure down. The same applies to corporate adoption, which is frequently read as a pure negative. Organizations used to multi-year transformation timelines find that the speed of development actually justifies inaction: why align everyone around a new model when it changes again in three months? Limited, clear pacing giving corporate customers breathing space to adapt could produce some genuinely positive economic results. \u003c/p\u003e\u003c/div\u003e\u003cstyle\u003e\n  p span[style*=\"font-size\"] { line-height: 1.6; }\n\u003c/style\u003e\u003cdiv style=\"padding-bottom:12px;padding-left:20px;padding-right:20px;padding-top:12px;\"\u003e\u003cp style=\"color:#1a1a1a;color:var(--wt-text-on-background-color) !important;font-family:'Georgia','Times New Roman',serif;font-size:15px;line-height:1.7;text-align:left;\"\u003e Alex Imas (X) \u003ca class=\"link\" href=\"https://x.com/alexolegimas/status/2098935035004875260?utm_source=aidailybrief.beehiiv.com\u0026utm_medium=referral\u0026utm_campaign=even-other-ai-labs-are-rallying-around-anthropic-s-slowdown-proposal\" target=\"_blank\" rel=\"noopener noreferrer nofollow\" style=\"-webkit-text-decoration:underline #1a1a1a;color:#1a1a1a;font-style:italic;text-decoration:underline #1a1a1a;word-break:break-word;;\"\u003ePacing is good for open models and for the medium-term economics of the entire ecosystem\u003c/a\u003e\u003c/p\u003e\u003c/div\u003e\u003cstyle\u003e\n  p span[style*=\"font-size\"] { line-height: 1.6; }\n\u003c/style\u003e\u003cdiv style=\"padding-bottom:12px;padding-left:20px;padding-right:20px;padding-top:12px;\"\u003e\u003cp style=\"color:#1a1a1a;color:var(--wt-text-on-background-color) !important;font-family:'Georgia','Times New Roman',serif;font-size:15px;line-height:1.7;text-align:left;\"\u003e\u003cb\u003eWashington reacts\u003c/b\u003e\u003cbr\u003e\u003ci\u003e\u0026quot;Whoever wins AI wins\u0026quot;\u003c/i\u003e\u003cbr\u003eThe political reactions have been broadly what you\u0026#39;d expect. President Trump downplayed the whole thing on Sunday, saying the US is leading China and he wants to keep it that way, and that a lot of negative forces are bringing up things that won\u0026#39;t happen. Bernie Sanders used the moment to promote the Superintelligence Ban Bill formally introduced on Friday, arguing that when you\u0026#39;re racing toward a cliff you don\u0026#39;t ease up on the gas, you hit the brakes, and that Trump and Xi must negotiate a treaty at their upcoming summit. Behind closed doors, Obama was reported to be urging Democrats to move AI regulation to the center of their platform for the midterms and 2028, saying he is neither a doomer nor an accelerationist but would make it one of his central agendas — with a clear plan for safety, for keeping kids from being corrupted, and for the concrete economics of job displacement. House Speaker Mike Johnson warned that an emergency session to regulate AI would lose the race to China, while also saying the AI companies should probably be summoned to the White House, put in a big room behind a closed door, and sorted out, and that he\u0026#39;d be the one pushing for it. \u003c/p\u003e\u003c/div\u003e\u003cstyle\u003e\n  p span[style*=\"font-size\"] { line-height: 1.6; }\n\u003c/style\u003e\u003cdiv style=\"padding-bottom:12px;padding-left:20px;padding-right:20px;padding-top:12px;\"\u003e\u003cp style=\"color:#1a1a1a;color:var(--wt-text-on-background-color) !important;font-family:'Georgia','Times New Roman',serif;font-size:15px;line-height:1.7;text-align:left;\"\u003e NPR \u003ca class=\"link\" href=\"https://www.npr.org/2026/09/13/nx-s1-5968078/trump-mike-johnson-ai-slowdown?utm_source=aidailybrief.beehiiv.com\u0026utm_medium=referral\u0026utm_campaign=even-other-ai-labs-are-rallying-around-anthropic-s-slowdown-proposal\" target=\"_blank\" rel=\"noopener noreferrer nofollow\" style=\"-webkit-text-decoration:underline #1a1a1a;color:#1a1a1a;font-style:italic;text-decoration:underline #1a1a1a;word-break:break-word;;\"\u003eTrump downplays calls for AI slowdown\u003c/a\u003e\u003cbr\u003eFT \u003ca class=\"link\" href=\"https://www.ft.com/content/cae60732-f929-4735-a627-db8c14e7c7ed?utm_source=aidailybrief.beehiiv.com\u0026utm_medium=referral\u0026utm_campaign=even-other-ai-labs-are-rallying-around-anthropic-s-slowdown-proposal\" target=\"_blank\" rel=\"noopener noreferrer nofollow\" style=\"-webkit-text-decoration:underline #1a1a1a;color:#1a1a1a;font-style:italic;text-decoration:underline #1a1a1a;word-break:break-word;;\"\u003eDonald Trump rejects calls from tech bosses for AI slowdown\u003c/a\u003e\u003cbr\u003eFox News (X) \u003ca class=\"link\" href=\"https://x.com/FoxNews/status/2099128502897250603?utm_source=aidailybrief.beehiiv.com\u0026utm_medium=referral\u0026utm_campaign=even-other-ai-labs-are-rallying-around-anthropic-s-slowdown-proposal\" target=\"_blank\" rel=\"noopener noreferrer nofollow\" style=\"-webkit-text-decoration:underline #1a1a1a;color:#1a1a1a;font-style:italic;text-decoration:underline #1a1a1a;word-break:break-word;;\"\u003eVideo of Trump\u0026#39;s remarks on the slowdown calls\u003c/a\u003e\u003cbr\u003eBernie Sanders (X) \u003ca class=\"link\" href=\"https://x.com/SenSanders/status/2098847403134611522?utm_source=aidailybrief.beehiiv.com\u0026utm_medium=referral\u0026utm_campaign=even-other-ai-labs-are-rallying-around-anthropic-s-slowdown-proposal\" target=\"_blank\" rel=\"noopener noreferrer nofollow\" style=\"-webkit-text-decoration:underline #1a1a1a;color:#1a1a1a;font-style:italic;text-decoration:underline #1a1a1a;word-break:break-word;;\"\u003ePacing is a start, but the future of humanity requires a pause and a superintelligence ban\u003c/a\u003e\u003cbr\u003ePolitico \u003ca class=\"link\" href=\"https://www.politico.com/news/2026/09/13/obama-ai-democrats-fundraiser-01073778?utm_source=aidailybrief.beehiiv.com\u0026utm_medium=referral\u0026utm_campaign=even-other-ai-labs-are-rallying-around-anthropic-s-slowdown-proposal\" target=\"_blank\" rel=\"noopener noreferrer nofollow\" style=\"-webkit-text-decoration:underline #1a1a1a;color:#1a1a1a;font-style:italic;text-decoration:underline #1a1a1a;word-break:break-word;;\"\u003eObama calls for Dems to focus on AI\u003c/a\u003e\u003cbr\u003eNYT \u003ca class=\"link\" href=\"https://www.nytimes.com/2026/09/13/us/politics/obama-democrats-ai.html?utm_source=aidailybrief.beehiiv.com\u0026utm_medium=referral\u0026utm_campaign=even-other-ai-labs-are-rallying-around-anthropic-s-slowdown-proposal\" target=\"_blank\" rel=\"noopener noreferrer nofollow\" style=\"-webkit-text-decoration:underline #1a1a1a;color:#1a1a1a;font-style:italic;text-decoration:underline #1a1a1a;word-break:break-word;;\"\u003eObama Urges Democrats to Move A.I. Oversight to the Center of Their Agenda\u003c/a\u003e\u003cbr\u003ePolitico \u003ca class=\"link\" href=\"https://www.politico.com/news/2026/09/13/tech-ai-safety-johnson-01073735?utm_source=aidailybrief.beehiiv.com\u0026utm_medium=referral\u0026utm_campaign=even-other-ai-labs-are-rallying-around-anthropic-s-slowdown-proposal\" target=\"_blank\" rel=\"noopener noreferrer nofollow\" style=\"-webkit-text-decoration:underline #1a1a1a;color:#1a1a1a;font-style:italic;text-decoration:underline #1a1a1a;word-break:break-word;;\"\u003eTech companies must be primarily responsible for AI safety, Mike Johnson says\u003c/a\u003e\u003cbr\u003eThe Hill \u003ca class=\"link\" href=\"https://thehill.com/policy/technology/6087028-democrats-urge-congress-ai-safety/?utm_source=aidailybrief.beehiiv.com\u0026utm_medium=referral\u0026utm_campaign=even-other-ai-labs-are-rallying-around-anthropic-s-slowdown-proposal\" target=\"_blank\" rel=\"noopener noreferrer nofollow\" style=\"-webkit-text-decoration:underline #1a1a1a;color:#1a1a1a;font-style:italic;text-decoration:underline #1a1a1a;word-break:break-word;;\"\u003eDem rep urges Johnson: \u0026#39;Bring us back to Congress\u0026#39; to discuss AI\u003c/a\u003e\u003cbr\u003eCNN (YouTube) \u003ca class=\"link\" href=\"https://www.youtube.com/watch?v=cLezSAuKgFI\u0026utm_source=aidailybrief.beehiiv.com\u0026utm_medium=referral\u0026utm_campaign=even-other-ai-labs-are-rallying-around-anthropic-s-slowdown-proposal\" target=\"_blank\" rel=\"noopener noreferrer nofollow\" style=\"-webkit-text-decoration:underline #1a1a1a;color:#1a1a1a;font-style:italic;text-decoration:underline #1a1a1a;word-break:break-word;;\"\u003eJohnson\u0026#39;s full Sunday interview with Jake Tapper\u003c/a\u003e\u003cbr\u003ePeter Wildeford (X) \u003ca class=\"link\" href=\"https://x.com/peterwildeford/status/2099249259124326568?utm_source=aidailybrief.beehiiv.com\u0026utm_medium=referral\u0026utm_campaign=even-other-ai-labs-are-rallying-around-anthropic-s-slowdown-proposal\" target=\"_blank\" rel=\"noopener noreferrer nofollow\" style=\"-webkit-text-decoration:underline #1a1a1a;color:#1a1a1a;font-style:italic;text-decoration:underline #1a1a1a;word-break:break-word;;\"\u003eJohnson says the AI companies should be summoned to the White House to sort this out\u003c/a\u003e\u003c/p\u003e\u003c/div\u003e\u003cstyle\u003e\n  p span[style*=\"font-size\"] { line-height: 1.6; }\n\u003c/style\u003e\u003cdiv style=\"padding-bottom:12px;padding-left:20px;padding-right:20px;padding-top:12px;\"\u003e\u003cp style=\"color:#1a1a1a;color:var(--wt-text-on-background-color) !important;font-family:'Georgia','Times New Roman',serif;font-size:15px;line-height:1.7;text-align:left;\"\u003e\u003cb\u003eChina calls it a Cold War tactic\u003c/b\u003e\u003cbr\u003e\u003ci\u003e\u0026quot;This silent AI Cold War is hypocritical and short-sighted\u0026quot;\u003c/i\u003e\u003cbr\u003eIn a follow-up CBS interview on Sunday night, Amodei said the toughest dilemma would be if China chose not to collaborate on a slowdown — which appears to be the state of play heading into Trump\u0026#39;s AI summit with Xi later this month. On Monday morning in Beijing, state newspaper the Global Times argued the essay\u0026#39;s purpose was to curb China\u0026#39;s AI development through technological barriers and regulatory monopolies, uphold Washington\u0026#39;s monopolistic hegemony, and exclude China from the global AI governance system, adding that shutting China out of frontier research would significantly increase the trial-and-error costs and loss-of-control risks of global AI development. Later that day the foreign ministry urged all nations toward an open, inclusive and benevolent approach, with a spokesperson saying that fomenting threats and malicious competition is not in the interest of any party. \u003c/p\u003e\u003c/div\u003e\u003cstyle\u003e\n  p span[style*=\"font-size\"] { line-height: 1.6; }\n\u003c/style\u003e\u003cdiv style=\"padding-bottom:12px;padding-left:20px;padding-right:20px;padding-top:12px;\"\u003e\u003cp style=\"color:#1a1a1a;color:var(--wt-text-on-background-color) !important;font-family:'Georgia','Times New Roman',serif;font-size:15px;line-height:1.7;text-align:left;\"\u003e Reuters \u003ca class=\"link\" href=\"https://www.reuters.com/world/china/china-state-newspaper-blasts-anthropics-calls-slow-ai-cold-war-tactic-2026-09-14/?utm_source=aidailybrief.beehiiv.com\u0026utm_medium=referral\u0026utm_campaign=even-other-ai-labs-are-rallying-around-anthropic-s-slowdown-proposal\" target=\"_blank\" rel=\"noopener noreferrer nofollow\" style=\"-webkit-text-decoration:underline #1a1a1a;color:#1a1a1a;font-style:italic;text-decoration:underline #1a1a1a;word-break:break-word;;\"\u003eChina state newspaper blasts Anthropic\u0026#39;s calls to slow AI as \u0026#39;Cold War\u0026#39; tactic\u003c/a\u003e\u003cbr\u003eFace the Nation (X) \u003ca class=\"link\" href=\"https://x.com/FaceTheNation/status/2099157536540594522?utm_source=aidailybrief.beehiiv.com\u0026utm_medium=referral\u0026utm_campaign=even-other-ai-labs-are-rallying-around-anthropic-s-slowdown-proposal\" target=\"_blank\" rel=\"noopener noreferrer nofollow\" style=\"-webkit-text-decoration:underline #1a1a1a;color:#1a1a1a;font-style:italic;text-decoration:underline #1a1a1a;word-break:break-word;;\"\u003eAmodei says joint governance by democratic governments may be the direction things need to go\u003c/a\u003e\u003c/p\u003e\u003c/div\u003e\u003cstyle\u003e\n  p span[style*=\"font-size\"] { line-height: 1.6; }\n\u003c/style\u003e\u003cdiv style=\"padding-bottom:12px;padding-left:20px;padding-right:20px;padding-top:12px;\"\u003e\u003cp style=\"color:#1a1a1a;color:var(--wt-text-on-background-color) !important;font-family:'Georgia','Times New Roman',serif;font-size:15px;line-height:1.7;text-align:left;\"\u003e\u003cb\u003eThe detente read\u003c/b\u003e\u003cbr\u003e\u003ci\u003e\u0026quot;More like Soviet-era detente than a pause\u0026quot;\u003c/i\u003e\u003cbr\u003eIzabella Kaminska offered an interesting alternative reading: the proposition resembles Nixon-era outreach to Russia over nukes, a comparison strengthened by the fact that detente was influenced by America becoming overstretched in Vietnam amid a growing balance of payments crisis. Detente didn\u0026#39;t stop nuclear engineering — buildout and silo growth were curtailed while engineers kept advancing capabilities, and SALT paced certain capabilities over others in a negotiated way. On that read, the proposal is to pace recursive development only after locking in a greater American advantage, which requires forging a domestic cartel and locking down work in ways that prevent Chinese distillation. China would never accept that without a compensating trade-off — NVIDIA chips, or a promise to slow buildout while they catch up — so what\u0026#39;s really on offer is a quid pro quo, and the better way to read the essay may be as an outreach to China to get open weights under control. \u003c/p\u003e\u003c/div\u003e\u003cstyle\u003e\n  p span[style*=\"font-size\"] { line-height: 1.6; }\n\u003c/style\u003e\u003cdiv style=\"padding-bottom:12px;padding-left:20px;padding-right:20px;padding-top:12px;\"\u003e\u003cp style=\"color:#1a1a1a;color:var(--wt-text-on-background-color) !important;font-family:'Georgia','Times New Roman',serif;font-size:15px;line-height:1.7;text-align:left;\"\u003e Izabella Kaminska (X) \u003ca class=\"link\" href=\"https://x.com/izakaminska/status/2099409613045014907?utm_source=aidailybrief.beehiiv.com\u0026utm_medium=referral\u0026utm_campaign=even-other-ai-labs-are-rallying-around-anthropic-s-slowdown-proposal\" target=\"_blank\" rel=\"noopener noreferrer nofollow\" style=\"-webkit-text-decoration:underline #1a1a1a;color:#1a1a1a;font-style:italic;text-decoration:underline #1a1a1a;word-break:break-word;;\"\u003eThe pacing proposition is Soviet-era detente, and really an outreach to China on open weights\u003c/a\u003e\u003c/p\u003e\u003c/div\u003e\u003cstyle\u003e\n  p span[style*=\"font-size\"] { line-height: 1.6; }\n\u003c/style\u003e\u003cdiv style=\"padding-bottom:12px;padding-left:20px;padding-right:20px;padding-top:12px;\"\u003e\u003cp style=\"color:#1a1a1a;color:var(--wt-text-on-background-color) !important;font-family:'Georgia','Times New Roman',serif;font-size:15px;line-height:1.7;text-align:left;\"\u003e\u003cb\u003eA more productive conversation\u003c/b\u003e\u003cbr\u003e\u003ci\u003e\u0026quot;p(doom) is not exogenous, it is endogenous\u0026quot;\u003c/i\u003e\u003cbr\u003eThe discourse around this feels considerably more productive than the discourse around last week\u0026#39;s researcher warnings, because it is specific and tangible. People are still rejecting it out of hand for very different reasons, but a lot of serious folks are treating this as a shift — the negotiation of what was always an inevitable next phase, in which the future of AI development is not defined solely by the labs and involves other actors in ways beyond shouting from outside the building. OpenAI\u0026#39;s Houda Nait el Barj captured the mood: she was more worried about existential risk in 2022 than today, not because the risks disappeared but because the biggest uncertainty back then was whether the labs would seriously invest in alignment as capabilities scaled. The probability of catastrophe depends on what labs, governments, researchers and society actually do, which makes a number stated without assumptions about those actions nearly meaningless — and the concrete questions are how frontier labs should collaborate on safety, how to align incentives, and how to communicate honestly about what these systems can do. \u003c/p\u003e\u003c/div\u003e\u003cstyle\u003e\n  p span[style*=\"font-size\"] { line-height: 1.6; }\n\u003c/style\u003e\u003cdiv style=\"padding-bottom:12px;padding-left:20px;padding-right:20px;padding-top:12px;\"\u003e\u003cp style=\"color:#1a1a1a;color:var(--wt-text-on-background-color) !important;font-family:'Georgia','Times New Roman',serif;font-size:15px;line-height:1.7;text-align:left;\"\u003e Houda Nait el Barj (X) \u003ca class=\"link\" href=\"https://x.com/Houda_nait/status/2099203081732755872?utm_source=aidailybrief.beehiiv.com\u0026utm_medium=referral\u0026utm_campaign=even-other-ai-labs-are-rallying-around-anthropic-s-slowdown-proposal\" target=\"_blank\" rel=\"noopener noreferrer nofollow\" style=\"-webkit-text-decoration:underline #1a1a1a;color:#1a1a1a;font-style:italic;text-decoration:underline #1a1a1a;word-break:break-word;;\"\u003eLess worried about existential risk than in 2022, because p(doom) is endogenous to what labs and governments actually do\u003c/a\u003e\u003c/p\u003e\u003c/div\u003e\u003cdiv style=\"font-size:0px;line-height:0px;padding:30px 0px 30px;\"\u003e\u003cdiv style=\"margin: 0 auto; border-top: 3px solid #e0ddd8; width:50%;\"\u003e\u003c/div\u003e\u003c/div\u003e\u003c/div\u003e\u003c/div\u003e\u003c/div\u003e\u003c/div\u003e\u003c/body\u003e\u003c/html\u003e","hide_premium_post":false,"contains_subscriber_break":false,"is_accessible_for_free":true,"paywall_shown":false,"metered_usage_shown":false,"metered_viewed_count":null,"force_premium":false,"enforce_paywall_breaks":true,"display_thumbnail_on_web":false,"display_title_on_web":true,"display_subtitle_on_web":true,"author_urls":{"e8878dba-aef2-421b-940f-22cfab8dc6bd":"https://aidailybrief.beehiiv.com/authors/ai-daily-brief"},"custom_structured_data":null,"tiptap_state":null},"publication":{"id":"31ab4dfa-c7e9-4e8e-87ca-70754bd4ffa6","name":"The AI Daily Brief","description":"The most important news and discussions in AI","tags":[{"id":37,"name":"business","created_at":"2021-06-15T00:05:23.579Z","updated_at":"2021-06-15T00:05:23.579Z","is_internal":false},{"id":90,"name":"artificial intelligence","created_at":"2021-06-15T00:05:24.893Z","updated_at":"2021-06-15T00:05:24.893Z","is_internal":false},{"id":107,"name":"finance","created_at":"2021-06-15T00:05:25.285Z","updated_at":"2021-06-15T00:05:25.285Z","is_internal":false}],"url":"https://aidailybrief.beehiiv.com/","web_theme":{"primary_color":"#0081aa","text_on_primary_color":"#FFFFFF","secondary_color":"#F9FAFB","text_on_secondary_color":"#030712","tertiary_color":"#FFFFFF","text_on_tertiary_color":"#222222","background_color":"#FFFFFF","text_on_background_color":"#222222","subscribe_background_color":"#FFFFFF","text_on_subscribe_background_color":"#222222","subscribe_theme":"light","content_theme":"light","border_style":"round","border_radius":"8px","border_color":"#E5E7EB","header_font":"Roboto","body_font":"Open Sans","button_font":"Open Sans","logo_shadow":"md","post_page_custom_css":"","name":null,"purpose":"web","owner_id":"31ab4dfa-c7e9-4e8e-87ca-70754bd4ffa6"},"cta_text":"Subscribe","copyright_text":null,"noindex_enabled":false,"double_opt_required":false,"premium_enabled":false,"premium_purchasable":false,