,"pageData":{"headerButtonItems":[],"isExplicit":false,"isIncomplete":false,"presentationOptions":[],"shelves":[{"contentType":"reviews","$kind":"LegacyShelf","id":"ReviewsShelf","displaySubtitleAsEyebrow":false,"hideFromCarPlay":false,"isHorizontal":false,"items":[{"id":"14355883517","date":"2026-07-27T21:30:53Z","title":"Uncompromising and phenomenal","contents":"I’m an AI professional and this is my single podcast. I listen to every single day.","rating":5,"reviewerName":"Jphpjp","moreAction":null,"$kind":"Review"}],"mergeWhenFetched":false}],"pageMetrics":{"instructions":[],"pageFields":{},"custom":{}},"$kind":"StandardPage","title":"Ratings & Reviews"},"animationBehavior":"infer","destinationPageHeader":"standard","origin":"inapp","presentationContext":"infer","$kind":"LegacyFlowAction","actionMetrics":{"data":[],"custom":{}},"presentationStyle":["textFollowsTintColor","hasDisclosureIndicatorCompactOnly"]},"$kind":"Review"},{"id":"14354137992","date":"2026-07-27T12:31:39Z","title":"The Entire Spectrum","contents":"I can’t recommend this podcast enough for people interested in learning how to use AI and the effects this technology is having on the US economy and our daily lives. That’s where NLW deserves the most credit - episodes are more than just useful, insightful, and current - they cover a broad range of high level topics and detailed AI/agentic how-to guides. Therefore this is the only podcast you need to become an expert on using AI and also see the big picture of its impact.","rating":5,"reviewerName":"NJF_2026","moreAction":{"page":"reviews","pageData":{"headerButtonItems":[],"isExplicit":false,"isIncomplete":false,"presentationOptions":[],"shelves":[{"contentType":"reviews","$kind":"LegacyShelf","id":"ReviewsShelf","displaySubtitleAsEyebrow":false,"hideFromCarPlay":false,"isHorizontal":false,"items":[{"id":"14354137992","date":"2026-07-27T12:31:39Z","title":"The Entire Spectrum","contents":"I can’t recommend this podcast enough for people interested in learning how to use AI and the effects this technology is having on the US economy and our daily lives. That’s where NLW deserves the most credit - episodes are more than just useful, insightful, and current - they cover a broad range of high level topics and detailed AI/agentic how-to guides. Therefore this is the only podcast you need to become an expert on using AI and also see the big picture of its impact.","rating":5,"reviewerName":"NJF_2026","moreAction":null,"$kind":"Review"}],"mergeWhenFetched":false}],"pageMetrics":{"instructions":[],"pageFields":{},"custom":{}},"$kind":"StandardPage","title":"Ratings & Reviews"},"animationBehavior":"infer","destinationPageHeader":"standard","origin":"inapp","presentationContext":"infer","$kind":"LegacyFlowAction","actionMetrics":{"data":[],"custom":{}},"presentationStyle":["textFollowsTintColor","hasDisclosureIndicatorCompactOnly"]},"$kind":"Review"},{"id":"14342097671","date":"2026-07-24T11:27:34Z","title":"Essential information every day","contents":"I haven’t missed an episode in 18 months!This podcast is my top recommendation for understanding AI and how our work, lives, and world is being transformed. (for the good).   Thanks NLW! Keep it up.","rating":5,"reviewerName":"MarKat1990","moreAction":{"page":"reviews","pageData":{"headerButtonItems":[],"isExplicit":false,"isIncomplete":false,"presentationOptions":[],"shelves":[{"contentType":"reviews","$kind":"LegacyShelf","id":"ReviewsShelf","displaySubtitleAsEyebrow":false,"hideFromCarPlay":false,"isHorizontal":false,"items":[{"id":"14342097671","date":"2026-07-24T11:27:34Z","title":"Essential information every day","contents":"I haven’t missed an episode in 18 months!This podcast is my top recommendation for understanding AI and how our work, lives, and world is being transformed. (for the good).   Thanks NLW! Keep it up.","rating":5,"reviewerName":"MarKat1990","moreAction":null,"$kind":"Review"}],"mergeWhenFetched":false}],"pageMetrics":{"instructions":[],"pageFields