{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://laidies.ai/schemas/learning-execution-metadata.schema.json",
  "title": "LAiDIES Learning execution metadata adapter",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "queueBinding", "records"],
  "properties": {
    "schemaVersion": { "const": "laidies-learning-execution-metadata.v1" },
    "queueBinding": { "$ref": "#/$defs/queueBinding" },
    "records": {
      "type": "array",
      "items": { "$ref": "#/$defs/record" }
    }
  },
  "$defs": {
    "queueBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "schemaVersion", "sha256"],
      "properties": {
        "path": { "const": "operations/product-stewards/learning-content-ecosystem/content-work-orders.json" },
        "schemaVersion": { "const": "1.1.0" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workOrderId", "ownerProductId", "events"],
      "properties": {
        "workOrderId": { "type": "string", "pattern": "^LCWO-[0-9]{3}$" },
        "ownerProductId": { "type": "string", "minLength": 1 },
        "events": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["state", "at"],
            "properties": {
              "state": {
                "enum": [
                  "SELECTION_PROPOSED",
                  "DISPATCH_RECEIPT_DRAFTED",
                  "OWNER_ACKNOWLEDGED",
                  "DISPATCHED",
                  "TERMINAL"
                ]
              },
              "at": { "type": "string", "format": "date-time" }
            }
          }
        }
      }
    }
  }
}
