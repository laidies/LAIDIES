{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://laidies.ai/schemas/content-producer-contract.schema.json",
  "title": "LAiDIES prevention-first content producer contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "candidateId", "surface", "contentClass", "producer",
    "readerContract", "canonicalTruth", "positiveExemplars",
    "knownFailurePreflight", "draftArchitecture", "representativeProofPlan",
    "ratchet", "status"
  ],
  "properties": {
    "schemaVersion": { "const": "laidies-content-producer-contract.v1" },
    "candidateId": { "type": "string", "minLength": 1 },
    "surface": { "type": "string", "minLength": 1 },
    "contentClass": { "enum": ["EPISODE", "CLASS", "EXPLANATION", "REFERENCE", "FAQ", "NEWS", "PRACTICE", "INTERACTIVE", "PROMOTIONAL", "MICROCOPY"] },
    "producer": { "type": "string", "minLength": 1 },
    "readerContract": { "type": "object" },
    "canonicalTruth": { "type": "array", "minItems": 1 },
    "positiveExemplars": { "type": "array", "minItems": 1 },
    "knownFailurePreflight": { "type": "object" },
    "draftArchitecture": { "type": "object" },
    "representativeProofPlan": { "type": "object" },
    "ratchet": { "type": "object" },
    "status": { "enum": ["READY_TO_DRAFT", "REPAIR_PRODUCER", "SUPERSEDED"] }
  }
}
