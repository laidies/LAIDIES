{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://laidies.ai/schemas/library-book-cold-reader-review.schema.json",
  "title": "LAiDIES substantial-book cold-reader outcome receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "artifactSha256", "reviewMode", "reviewer", "administrator",
    "reviewedAt", "makerReceiptsOpenedAfterColdRead", "reverseBrief",
    "participantObservations", "nonCompensableVetoes", "verdict", "limitations"
  ],
  "properties": {
    "schemaVersion": { "const": "library-book-cold-reader-review.v2" },
    "artifactSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "reviewMode": { "const": "ARTIFACT_FIRST_COLD" },
    "reviewer": { "type": "string", "minLength": 1 },
    "administrator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["principalId", "makerPrincipalId", "independentFromMaker"],
      "properties": {
        "principalId": { "type": "string", "minLength": 1 },
        "makerPrincipalId": { "type": "string", "minLength": 1 },
        "independentFromMaker": { "const": true }
      }
    },
    "reviewedAt": { "type": "string", "format": "date-time" },
    "makerReceiptsOpenedAfterColdRead": { "const": true },
    "reverseBrief": {
      "type": "object",
      "additionalProperties": false,
      "required": ["readerJob", "centralMentalModel", "practicalPayoff", "readingMode"],
      "properties": {
        "readerJob": { "type": "string", "minLength": 1 },
        "centralMentalModel": { "type": "string", "minLength": 1 },
        "practicalPayoff": { "type": "string", "minLength": 1 },
        "readingMode": { "type": "string", "minLength": 1 }
      }
    },
    "participantObservations": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "participantId", "evidenceType", "familiarity", "observedAt",
          "readerTasks", "observationBinding"
        ],
        "properties": {
          "participantId": { "type": "string", "minLength": 1 },
          "evidenceType": { "const": "OBSERVED_HUMAN" },
          "familiarity": { "const": "UNFAMILIAR_WITH_ARTIFACT" },
          "observedAt": { "type": "string", "format": "date-time" },
          "readerTasks": {
            "type": "array",
            "minItems": 4,
            "items": { "$ref": "#/$defs/readerTask" }
          },
          "observationBinding": { "$ref": "#/$defs/binding" }
        }
      }
    },
    "nonCompensableVetoes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "openingOrientation", "promiseFidelity", "connectedProgression", "lookupAndRecovery",
        "unseenTransfer", "analogyIntegrity", "audienceExamples", "misconceptionResistance",
        "materialAccuracy", "continuousRenderedReadability", "laidiesVoice"
      ],
      "properties": {
        "openingOrientation": { "const": "PASS" },
        "promiseFidelity": { "const": "PASS" },
        "connectedProgression": { "const": "PASS" },
        "lookupAndRecovery": { "const": "PASS" },
        "unseenTransfer": { "const": "PASS" },
        "analogyIntegrity": { "const": "PASS" },
        "audienceExamples": { "const": "PASS" },
        "misconceptionResistance": { "const": "PASS" },
        "materialAccuracy": { "const": "PASS" },
        "continuousRenderedReadability": { "const": "PASS" },
        "laidiesVoice": { "const": "PASS" }
      }
    },
    "verdict": { "const": "ADMISSION_CANDIDATE" },
    "limitations": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "readerTask": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "prompt", "observedResponse", "expectedEvidence", "verdict", "artifactLocator"],
      "properties": {
        "kind": { "enum": ["ORIENTATION", "LOOKUP", "EXPLAIN_BACK", "UNSEEN_TRANSFER", "ANALOGY_STRIP_TEST", "ROUTE_RECOVERY"] },
        "prompt": { "type": "string", "minLength": 1 },
        "observedResponse": { "type": "string", "minLength": 1 },
        "expectedEvidence": { "type": "string", "minLength": 1 },
        "verdict": { "enum": ["PASS", "HOLD"] },
        "artifactLocator": { "type": "string", "minLength": 1 }
      }
    }
  }
}
