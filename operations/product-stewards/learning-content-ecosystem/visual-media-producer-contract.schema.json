{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://laidies.ai/schemas/visual-media-producer-contract-1.0.0.json",
  "title": "LAiDIES visual media producer contract",
  "type": "object",
  "required": ["schemaVersion","candidateId","surface","mediaClass","status","registry","intent","companion","truth","references","objectMap","textPlan","knownDefects","makerPreflight"],
  "properties": {
    "schemaVersion": {"const":"1.0.0"},
    "candidateId": {"type":"string","minLength":1},
    "surface": {"type":"string","minLength":1},
    "mediaClass": {"enum":["STILL","ANIMATION","ANIMATION_SOURCE","IDENT","LOOP"]},
    "status": {"const":"READY_TO_RENDER"},
    "registry": {"type":"object","required":["path","sha256","positiveExemplarId"],"properties":{"path":{"type":"string"},"sha256":{"pattern":"^[a-f0-9]{64}$"},"positiveExemplarId":{"type":"string"}}},
    "intent": {"type":"object","required":["placement","scenePurpose","viewerUnderstanding","visualJob"],"properties":{"placement":{"type":"string"},"scenePurpose":{"type":"string"},"viewerUnderstanding":{"type":"string"},"visualJob":{"enum":["ESTABLISH","EXPLAIN","COMPARE","DEMONSTRATE","REINFORCE","COMPLICATE","TRANSITION","BREATHING"]}}},
    "companion": {"type":"object","required":["kind","path","sha256","locator","exactTextOrSilentPurpose"],"properties":{"kind":{"enum":["TEXT","NARRATION","CAPTION","SILENT_PURPOSE"]},"path":{"type":"string"},"sha256":{"pattern":"^[a-f0-9]{64}$"},"locator":{"type":"string"},"exactTextOrSilentPurpose":{"type":"string"}}},
    "knownDefects": {"type":"array","minItems":1},
    "makerPreflight": {"type":"object","required":["knownDefectsRemaining","objectiveDefectsRemaining","representativeProofFirst"],"properties":{"knownDefectsRemaining":{"const":0},"objectiveDefectsRemaining":{"const":0},"representativeProofFirst":{"const":true}}}
  },
  "additionalProperties": true
}
