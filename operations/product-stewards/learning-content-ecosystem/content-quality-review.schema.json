{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://laidies.ai/schemas/content-quality-review.schema.json",
  "title": "LAiDIES artifact-bound content quality review receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "workOrderId", "gate", "verdict", "artifact",
    "maker", "reviewer", "reviewedAt", "findings", "evidence",
    "limitations", "freshness"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "workOrderId": { "type": "string", "pattern": "^LCWO-[0-9]{3}$" },
    "gate": {
      "enum": [
        "accuracy", "antiSlop", "currentBestPractice", "laidiesVoice",
        "analogyIntegrity", "usefulnessDepth", "formatFit",
        "searchIndexing", "relationshipLinking", "canonConsistency",
        "songOpportunity", "derivativeFeeds"
      ]
    },
    "verdict": { "enum": ["PASS", "HOLD", "NOT_APPLICABLE"] },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifestPath", "sha256"],
      "properties": {
        "manifestPath": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "maker": { "type": "string", "minLength": 1 },
    "reviewer": { "type": "string", "minLength": 1 },
    "reviewedAt": { "type": "string", "format": "date-time" },
    "findings": { "type": "string", "minLength": 1 },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceRefs", "testRefs"],
      "properties": {
        "sourceRefs": { "type": "array", "items": { "type": "string" } },
        "testRefs": { "type": "array", "items": { "type": "string" } }
      }
    },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewedThrough", "nextTrigger", "correctionOwner"],
      "properties": {
        "reviewedThrough": { "type": "string", "format": "date" },
        "nextTrigger": { "type": "string", "minLength": 1 },
        "correctionOwner": { "type": "string", "minLength": 1 }
      }
    },
    "surfaceAdaptation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface", "destinationJob", "payloadPath", "renderedEvidencePaths",
        "interactionEvidencePaths", "distinctFromOtherSurfaces"
      ],
      "properties": {
        "surface": { "type": "string", "minLength": 1 },
        "destinationJob": { "type": "string", "minLength": 1 },
        "payloadPath": { "type": "string", "minLength": 1 },
        "renderedEvidencePaths": {
          "type": "array", "minItems": 1, "items": { "type": "string" }
        },
        "interactionEvidencePaths": {
          "type": "array", "items": { "type": "string" }
        },
        "distinctFromOtherSurfaces": { "type": "string", "minLength": 1 }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "gate": { "const": "formatFit" } } },
      "then": { "required": ["surfaceAdaptation"] }
    }
  ]
}
