{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://laidies.ai/internal/schemas/successor-assembly-lineage-v1.json",
  "title": "LAiDIES successor video assembly lineage",
  "type": "object",
  "required": [
    "schema_version",
    "lineage_id",
    "content_id",
    "state",
    "source_inventory",
    "prior_sequences",
    "admission_status"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "lineage_id": { "type": "string", "minLength": 1 },
    "content_id": { "type": "string", "minLength": 1 },
    "state": {
      "enum": ["PREASSEMBLY_HOLD", "SUCCESSOR_ASSEMBLED_HOLD", "SUCCESSOR_REVIEWED"]
    },
    "source_inventory": {
      "type": "object",
      "required": ["manifest_path", "sha256", "collection_key"]
    },
    "prior_sequences": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["sequence_id", "path", "sha256", "occurrences", "audio_seconds", "disposition"]
      }
    },
    "successor": { "type": ["object", "null"] },
    "admission_status": { "enum": ["PASS", "HOLD", "FAIL"] }
  }
}
