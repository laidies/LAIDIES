#!/bin/sh
# SUNNYVAiLE pre-commit gate.
# Bypass consciously with: git commit --no-verify
#
# 2026-07-22: check-episode-cues.js, check-local-links.js and check-inline-js.js
# were written, correct, and wired to nothing. They run here now, alongside
# check-town.js — and inside operations/engine/gate.sh.
TOPLEVEL="$(git rev-parse --show-toplevel)"

fail=0
for check in check-town check-episode-cues check-local-links check-inline-js; do
  if [ -f "$TOPLEVEL/scripts/$check.js" ]; then
    node "$TOPLEVEL/scripts/$check.js" || fail=1
  fi
done

if [ "$fail" -ne 0 ]; then
  echo ""
  echo "Commit blocked. Fix what's listed above, or bypass with --no-verify if you mean it."
  exit 1
fi
