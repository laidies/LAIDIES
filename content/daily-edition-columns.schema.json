{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://laidies.ai/schemas/daily-edition-columns.schema.json",
  "title": "The Daily dated service-column selections",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "owner", "updatedAt", "emptyStates", "records"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "owner": { "const": "newsstand-daily" },
    "updatedAt": { "type": "string", "format": "date" },
    "emptyStates": { "type": "object" },
    "records": { "type": "array", "items": { "$ref": "#/$defs/record" } }
  },
  "$defs": {
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "editionDate", "type", "classification", "status", "headline", "summary", "sourcePath", "sourceId", "destination", "owner", "freshness", "reviewEvidence", "publicEligibility"],
      "properties": {
        "id": { "type": "string", "pattern": "^DAILY-[0-9]{4}-[0-9]{2}-[0-9]{2}-[A-Z0-9-]+$" },
        "editionDate": { "type": "string", "format": "date" },
        "type": { "enum": ["paige_tip", "promptoscope", "career_life", "dear_miss_jeeves", "mme_claio", "song", "did_you_know", "town_note", "curiosity", "fiction"] },
        "classification": { "enum": ["sourced_service", "authored_reflection", "audio", "fiction"] },
        "status": { "enum": ["CANDIDATE", "HOLD", "APPROVED", "PUBLISHED", "CORRECTED", "RETRACTED", "EXPIRED"] },
        "headline": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "sourcePath": { "type": "string", "minLength": 1 },
        "sourceId": { "type": "string", "minLength": 1 },
        "destination": { "type": ["string", "null"] },
        "owner": { "type": "string", "minLength": 1 },
        "freshness": {
          "type": "object",
          "additionalProperties": false,
          "required": ["lastCheckedAt", "expiresAt", "recheckTriggers"],
          "properties": {
            "lastCheckedAt": { "type": "string", "format": "date" },
            "expiresAt": { "type": "string", "format": "date" },
            "recheckTriggers": { "type": "array", "minItems": 1, "items": { "type": "string" } }
          }
        },
        "reviewEvidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["accuracy", "editorial", "voice", "format", "owner", "safety"],
          "properties": {
            "accuracy": { "type": ["string", "null"] },
            "editorial": { "type": ["string", "null"] },
            "voice": { "type": ["string", "null"] },
            "format": { "type": ["string", "null"] },
            "owner": { "type": ["string", "null"] },
            "safety": { "type": ["string", "null"] }
          }
        },
        "publicEligibility": { "enum": ["ELIGIBLE", "INELIGIBLE"] }
      }
    }
  }
}
