{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://laidies.ai/content/newsstand.schema.json",
  "title": "SUNNYVAiLE NewsStand public publication dataset",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "datasetStatus", "generatedAt", "lastCheckedAt", "publications", "stories"],
  "properties": {
    "schemaVersion": { "const": "2.0.0" },
    "datasetStatus": { "enum": ["published", "hold"] },
    "generatedAt": { "type": "string", "format": "date-time" },
    "lastCheckedAt": { "type": "string", "format": "date-time" },
    "publications": {
      "type": "object",
      "additionalProperties": false,
      "required": ["breaking", "daily", "weekly", "big-picture"],
      "properties": {
        "breaking": { "$ref": "#/$defs/publication" },
        "daily": { "$ref": "#/$defs/publication" },
        "weekly": { "$ref": "#/$defs/publication" },
        "big-picture": { "$ref": "#/$defs/publication" }
      }
    },
    "stories": {
      "type": "array",
      "items": { "$ref": "#/$defs/story" }
    }
  },
  "$defs": {
    "nullableDateTime": {
      "anyOf": [
        { "type": "string", "format": "date-time" },
        { "type": "null" }
      ]
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["edition", "job", "status", "publishedAt", "updatedAt", "lastCheckedAt", "maxAgeHours", "note"],
      "properties": {
        "edition": { "enum": ["breaking", "daily", "weekly", "big-picture"] },
        "job": { "type": "string", "minLength": 20 },
        "status": { "enum": ["quiet", "current", "hold", "unavailable"] },
        "publishedAt": { "$ref": "#/$defs/nullableDateTime" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "lastCheckedAt": { "type": "string", "format": "date-time" },
        "maxAgeHours": { "type": "number", "exclusiveMinimum": 0 },
        "note": { "type": "string", "minLength": 10 },
        "editionDate": { "type": "string", "format": "date" },
        "editorialTimeZone": { "type": "string", "minLength": 3 },
        "issue": {
          "type": "object",
          "additionalProperties": true,
          "required": ["status", "storyIds", "serviceRecordIds"],
          "properties": {
            "status": { "const": "complete" },
            "storyIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
            "serviceRecordIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "edition": { "const": "daily" }, "status": { "const": "current" } }, "required": ["edition", "status"] },
          "then": { "required": ["editionDate", "editorialTimeZone", "issue"] }
        },
        {
          "if": { "properties": { "edition": { "const": "weekly" }, "status": { "const": "current" } }, "required": ["edition", "status"] },
          "then": { "required": ["editionDate", "editorialTimeZone"] }
        }
      ]
    },
    "story": {
      "type": "object",
      "required": [
        "id", "slug", "edition", "status", "publishedAt", "updatedAt", "lastCheckedAt",
        "sourceApproval", "correction", "correctionHistory", "retraction", "predecessorStoryIds", "successorStoryIds",
        "relationshipType", "bigPicture", "headline", "the_story", "laidies_read",
        "what_this_means", "cocktail_party", "class_notes", "sources", "themes", "concepts", "tags"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 3 },
        "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "edition": { "enum": ["breaking", "daily", "weekly", "big-picture"] },
        "status": { "enum": ["published", "hold", "corrected", "retracted"] },
        "publishedAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "lastCheckedAt": { "type": "string", "format": "date-time" },
        "sourceApproval": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "record"],
          "properties": {
            "status": { "enum": ["approved", "independent-review-required", "rejected"] },
            "record": { "type": "string", "pattern": "^newsstand:source-approval:[a-z0-9][a-z0-9._-]{1,127}$" }
          }
        },
        "correction": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["correctedAt", "summary", "owner", "successorStoryId"],
              "properties": {
                "correctedAt": { "type": "string", "format": "date-time" },
                "summary": { "type": "string", "minLength": 10 },
                "owner": { "type": "string", "minLength": 3 },
                "successorStoryId": { "type": "string", "minLength": 3 }
              }
            }
          ]
        },
        "correctionHistory": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["correctedAt", "summary", "owner", "successorStoryId"],
            "properties": {
              "correctedAt": { "type": "string", "format": "date-time" },
              "summary": { "type": "string", "minLength": 10 },
              "owner": { "type": "string", "minLength": 3 },
              "successorStoryId": { "type": "string", "minLength": 3 }
            }
          }
        },
        "retraction": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["retractedAt", "reason", "owner"],
              "properties": {
                "retractedAt": { "type": "string", "format": "date-time" },
                "reason": { "type": "string", "minLength": 10 },
                "owner": { "type": "string", "minLength": 3 }
              }
            }
          ]
        },
        "predecessorStoryIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 3 } },
        "successorStoryIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 3 } },
        "relationshipType": {
          "type": ["string", "null"],
          "enum": [null, "confirms", "narrows", "complicates", "contradicts", "corrects", "new-branch"]
        },
        "bigPicture": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["threadId", "originallyPublishedAt", "lastMeaningfullyUpdatedAt", "sourcesLastCheckedAt", "changeLog", "previousVersions"],
              "properties": {
                "threadId": { "type": "string", "minLength": 3 },
                "originallyPublishedAt": { "type": "string", "format": "date-time" },
                "lastMeaningfullyUpdatedAt": { "type": "string", "format": "date-time" },
                "sourcesLastCheckedAt": { "type": "string", "format": "date-time" },
                "changeLog": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["changedAt", "kind", "summary"],
                    "properties": {
                      "changedAt": { "type": "string", "format": "date-time" },
                      "kind": { "enum": ["initial-publication", "evidence", "argument", "confidence", "correction"] },
                      "summary": { "type": "string", "minLength": 10 }
                    }
                  }
                },
                "previousVersions": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["versionId", "replacedAt"],
                    "properties": {
                      "versionId": { "type": "string", "minLength": 3 },
                      "replacedAt": { "type": "string", "format": "date-time" }
                    }
                  }
                }
              }
            }
          ]
        },
        "headline": { "type": "string", "minLength": 10 },
        "heroVisual": {
          "type": "object",
          "additionalProperties": false,
          "required": ["src", "alt", "credit", "approvalId"],
          "properties": {
            "src": { "type": "string", "pattern": "^/(?:approved-assets|assets)/[A-Za-z0-9._~!$&'()*+,;=:@%/-]+\\.(?:png|jpe?g|webp|avif)$" },
            "alt": { "type": "string", "minLength": 10, "maxLength": 240 },
            "credit": { "type": "string", "minLength": 3, "maxLength": 160 },
            "approvalId": { "type": "string", "pattern": "^newsstand:visual-approval:[a-z0-9][a-z0-9._-]{1,127}$" }
          }
        },
        "the_story": { "type": "string", "minLength": 20 },
        "laidies_read": { "type": "string", "minLength": 20 },
        "what_this_means": { "type": "string", "minLength": 20 },
        "cocktail_party": { "type": "string", "minLength": 20 },
        "class_notes": { "type": "string", "minLength": 10 },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "url", "publisherType", "accessedAt", "approvalStatus"],
            "properties": {
              "id": { "type": "string", "minLength": 3 },
              "label": { "type": "string", "minLength": 5 },
              "url": { "type": "string", "format": "uri" },
              "publisherType": { "enum": ["vendor", "regulator", "academic", "independent-reporting", "primary-document"] },
              "accessedAt": { "type": "string", "format": "date" },
              "approvalStatus": { "enum": ["reviewed", "rejected"] }
            }
          }
        },
        "themes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 2 } },
        "concepts": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 2 } },
        "tags": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 2 } }
      }
    }
  }
}
